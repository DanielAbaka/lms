<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Enrollment rules -->
        <record id="rule_lms_enrollment_student" model="ir.rule">
            <field name="name">Student Enrollment Access</field>
            <field name="model_id" ref="model_lms_enrollment"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
            <field name="domain_force">[('student_id', '=', user.id)]</field>
        </record>
        <record id="rule_lms_enrollment_teacher" model="ir.rule">
            <field name="name">Teacher Enrollment Access</field>
            <field name="model_id" ref="model_lms_enrollment"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_teacher'))]"/>
            <field name="domain_force">[('course_id.teacher_assignment_ids.teacher_id', '=', user.id)]</field>
        </record>

        <!-- Attendance rules -->
        <record id="rule_lms_attendance_student" model="ir.rule">
            <field name="name">Student Attendance Access</field>
            <field name="model_id" ref="model_lms_attendance"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
            <field name="domain_force">[('student_id', '=', user.id)]</field>
        </record>
        <record id="rule_lms_attendance_teacher" model="ir.rule">
            <field name="name">Teacher Attendance Access</field>
            <field name="model_id" ref="model_lms_attendance"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_teacher'))]"/>
            <field name="domain_force">[('course_id.teacher_assignment_ids.teacher_id', '=', user.id)]</field>
        </record>

        <!-- Grades -->
        <record id="rule_lms_grade_student" model="ir.rule">
            <field name="name">Student Grade Access</field>
            <field name="model_id" ref="model_lms_grade"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
            <field name="domain_force">[('student_id', '=', user.id)]</field>
        </record>
        <record id="rule_lms_grade_teacher" model="ir.rule">
            <field name="name">Teacher Grade Access</field>
            <field name="model_id" ref="model_lms_grade"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_teacher'))]"/>
            <field name="domain_force">[('course_id.teacher_assignment_ids.teacher_id', '=', user.id)]</field>
        </record>

        <!-- Documents -->
        <record id="rule_lms_documents_student" model="ir.rule">
            <field name="name">Student Document Access</field>
            <field name="model_id" ref="model_lms_document"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
            <field name="domain_force">[('course_id.enrollment_ids.student_id', '=', user.id)]</field>
        </record>
        <record id="rule_lms_documents_teacher" model="ir.rule">
            <field name="name">Teacher Document Access</field>
            <field name="model_id" ref="model_lms_document"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_teacher'))]"/>
            <field name="domain_force">[('teacher_assignment_id.teacher_id', '=', user.id)]</field>
        </record>

        <!-- Course planning -->
        <record id="rule_lms_course_planning_student" model="ir.rule">
            <field name="name">Student Course Planning Access</field>
            <field name="model_id" ref="model_lms_course_planning"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
            <field name="domain_force">[('student_id', '=', user.id)]</field>
        </record>

        <!-- Payment transaction (from Odoo Payment) -->
        <record id="rule_lms_payment_student" model="ir.rule">
            <field name="name">Student Payment Access</field>
            <!-- If you truly want to reference model_payment_transaction from Odoo payment -->
            <field name="model_id" ref="payment.model_payment_transaction"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        </record>

        <!-- Transcripts -->
        <record id="rule_lms_transcript_student" model="ir.rule">
            <field name="name">Student Transcript Access</field>
            <field name="model_id" ref="model_lms_transcript"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
            <field name="domain_force">[('student_id', '=', user.id)]</field>
        </record>

        <!-- Admin for academic year -->
        <record id="rule_lms_academic_admin" model="ir.rule">
            <field name="name">Admin Academic Access</field>
            <field name="model_id" ref="model_lms_academic_year"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[]</field>
        </record>
        <record id="rule_lms_admin_records" model="ir.rule">
            <field name="name">Admin Records Access</field>
            <field name="model_id" ref="model_lms_academic_year"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[('admin_id', '=', user.id)]</field>
        </record>

        <!-- Admin can only see their own students/teachers (on res.users, if you store them that way) -->
        <record id="rule_lms_admin_students" model="ir.rule">
            <field name="name">Admin Student Access</field>
            <field name="model_id" ref="model_res_users"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[('admin_id', '=', user.id), ('is_student', '=', True)]</field>
        </record>
        <record id="rule_lms_admin_teachers" model="ir.rule">
            <field name="name">Admin Teacher Access</field>
            <field name="model_id" ref="model_res_users"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[('admin_id', '=', user.id), ('is_teacher', '=', True)]</field>
        </record>

        <!-- Admin can only see their own courses if they're stored on slide.channel -->
        <record id="rule_lms_admin_courses" model="ir.rule">
            <field name="name">Admin Course Access</field>
            <field name="model_id" ref="website_slides.model_slide_channel"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[('admin_id', '=', user.id)]</field>
        </record>

        <record id="rule_lms_semester_admin" model="ir.rule">
            <field name="name">Admin Semester Access</field>
            <field name="model_id" ref="model_lms_semester"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[]</field>
        </record>

        <!-- Quizzes for students/teachers -->
        <record id="rule_lms_quiz_student" model="ir.rule">
            <field name="name">Quiz: Students can see assigned quizzes</field>
            <field name="model_id" ref="model_lms_quiz"/>
            <field name="domain_force">[('teacher_assignment_id.enrollment_ids.student_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_lms_quiz_teacher" model="ir.rule">
            <field name="name">Quiz: Teachers assigned</field>
            <field name="model_id" ref="model_lms_quiz"/>
            <field name="domain_force">[('teacher_assignment_id.teacher_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_teacher'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_lms_quiz_question_student" model="ir.rule">
            <field name="name">Quiz Questions: Students for their course quizzes</field>
            <field name="model_id" ref="model_lms_quiz_question"/>
            <field name="domain_force">[('quiz_id.teacher_assignment_id.enrollment_ids.student_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_lms_quiz_question_teacher" model="ir.rule">
            <field name="name">Quiz Questions: Teachers for assigned course</field>
            <field name="model_id" ref="model_lms_quiz_question"/>
            <field name="domain_force">[('quiz_id.teacher_assignment_id.teacher_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_teacher'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_lms_quiz_attempt_student" model="ir.rule">
            <field name="name">Quiz Attempts: Students see own attempts</field>
            <field name="model_id" ref="model_lms_quiz_attempt"/>
            <field name="domain_force">['|', ('student_id', '=', user.id), ('quiz_id.teacher_assignment_id.enrollment_ids.student_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_lms_quiz_attempt_teacher" model="ir.rule">
            <field name="name">Quiz Attempts: Teachers for assigned course</field>
            <field name="model_id" ref="model_lms_quiz_attempt"/>
            <field name="domain_force">[('quiz_id.teacher_assignment_id.teacher_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_teacher'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_lms_document_student" model="ir.rule">
            <field name="name">Student Document Access</field>
            <field name="model_id" ref="model_lms_document"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
            <field name="domain_force">[('teacher_assignment_id.course_id.enrollment_ids.student_id', '=', user.id)]</field>
        </record>
        <record id="rule_lms_document_teacher" model="ir.rule">
            <field name="name">Teacher Document Access</field>
            <field name="model_id" ref="model_lms_document"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_teacher'))]"/>
            <field name="domain_force">[('teacher_assignment_id.teacher_id', '=', user.id)]</field>
        </record>

        <record id="rule_lms_document_access_student" model="ir.rule">
            <field name="name">Student Document Access Log Access</field>
            <field name="model_id" ref="model_lms_document_access"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>
        <record id="rule_lms_document_access_teacher" model="ir.rule">
            <field name="name">Teacher Document Access Log Access</field>
            <field name="model_id" ref="model_lms_document_access"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_teacher'))]"/>
            <field name="domain_force">[('document_id.teacher_assignment_id.teacher_id', '=', user.id)]</field>
        </record>

        <record id="rule_lms_schedule_student" model="ir.rule">
            <field name="name">Student Schedule Access</field>
            <field name="model_id" ref="model_lms_schedule"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
            <field name="domain_force">[('course_id.enrollment_ids.student_id', '=', user.id)]</field>
        </record>
        <record id="rule_lms_schedule_teacher" model="ir.rule">
            <field name="name">Teacher Schedule Access</field>
            <field name="model_id" ref="model_lms_schedule"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_teacher'))]"/>
            <field name="domain_force">[('teacher_assignment_id.teacher_id', '=', user.id)]</field>
        </record>
        <record id="rule_lms_schedule_admin" model="ir.rule">
            <field name="name">Admin Schedule Access</field>
            <field name="model_id" ref="model_lms_schedule"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[]</field>
        </record>

        <record id="rule_lms_schedule_template_admin" model="ir.rule">
            <field name="name">Admin Schedule Template Access</field>
            <field name="model_id" ref="model_lms_schedule_template"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[]</field>
        </record>
        <record id="rule_lms_schedule_bulk_admin" model="ir.rule">
            <field name="name">Admin Bulk Schedule Creation Access</field>
            <field name="model_id" ref="model_lms_schedule_bulk_wizard"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[]</field>
        </record>

        <record id="rule_lms_room_availability_teacher" model="ir.rule">
            <field name="name">Teacher Room Availability Access</field>
            <field name="model_id" ref="model_lms_room_availability_wizard"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_teacher'))]"/>
            <field name="domain_force">[]</field>
        </record>
        <record id="rule_lms_room_availability_admin" model="ir.rule">
            <field name="name">Admin Room Availability Access</field>
            <field name="model_id" ref="model_lms_room_availability_wizard"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[]</field>
        </record>

    </data>
</odoo>
