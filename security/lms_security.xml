<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Define a module category for LMS -->
    <record id="module_category_lms" model="ir.module.category">
      <field name="name">Learning Management</field>
      <field name="description">Manage learning activities and academic processes</field>
      <field name="sequence">50</field>
    </record>

    <!-- LMS Manager Group -->
    <record id="group_lms_manager" model="res.groups">
      <field name="name">LMS Manager</field>
      <field name="category_id" ref="lms_module.module_category_lms"/>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
      <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- LMS User Group -->
    <record id="group_lms_user" model="res.groups">
      <field name="name">LMS User</field>
      <field name="category_id" ref="lms_module.module_category_lms"/>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
        
    <!-- Student Group -->
    <record id="group_lms_student" model="res.groups">
      <field name="name">Student</field>
      <field name="category_id" ref="lms_module.module_category_lms"/>
      <field name="implied_ids" eval="[(4, ref('lms_module.group_lms_user'))]"/>
    </record>
        
    <!-- Teacher Group -->
    <record id="group_lms_teacher" model="res.groups">
      <field name="name">Teacher</field>
      <field name="category_id" ref="lms_module.module_category_lms"/>
      <field name="implied_ids" eval="[(4, ref('lms_module.group_lms_user'))]"/>
    </record>
  </data>
</odoo>
