<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Only keep the Quiz model rules -->
        
        <!-- Quiz Rules -->
        <record id="rule_lms_quiz_student" model="ir.rule">
            <field name="name">Quiz Student Rule</field>
            <field name="model_id" ref="model_lms_quiz"/>
            <field name="domain_force">[('course_id.enrollment_ids.student_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <record id="rule_lms_quiz_teacher" model="ir.rule">
            <field name="name">Quiz Teacher Rule</field>
            <field name="model_id" ref="model_lms_quiz"/>
            <field name="domain_force">[('teacher_assignment_id.teacher_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_teacher'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
