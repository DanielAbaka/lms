            <field name="domain_force">[('course_id.teacher_assignment_ids.teacher_id', '=', user.id)]</field>
        </record>

        <!-- Student can only access documents related to enrolled courses -->
        <record id="rule_lms_documents_student" model="ir.rule">
            <field name="name">Student Document Access</field>
            <!-- If lms.document is your model, ensure you use model_lms_document, not model_documents_document -->
            <field name="model_id" ref="model_lms_document"/>
            <field name="groups" eval="[(4, ref('group_lms_student'))]"/>
            <!-- Something like user.enrolled_courses might not be valid. Adjust to your actual field. -->
            <field name="domain_force">[('course_id', 'in', user.enrolled_courses.ids)]</field>
        </record>

        <!-- Teacher can manage documents related to their assigned courses -->
        <record id="rule_lms_documents_teacher" model="ir.rule">
