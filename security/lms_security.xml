<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <!-- =========================================================================
         Enrollment Rules
         ========================================================================= -->
    <!-- Students can only see their own enrollments -->
    <record id="rule_lms_enrollment_student" model="ir.rule">
      <field name="name">Student Enrollment Access</field>
      <field name="model_id" ref="model_lms_enrollment"/>
      <field name="domain_force">[('student_id', '=', user.id)]</field>
      <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Teachers can see enrollments for courses they are assigned to -->
    <record id="rule_lms_enrollment_teacher" model="ir.rule">
      <field name="name">Teacher Enrollment Access</field>
      <field name="model_id" ref="model_lms_enrollment"/>
      <field name="domain_force">[('course_id.teacher_assignment_ids.teacher_id', '=', user.id)]</field>
      <field name="groups" eval="[(4, ref('lms_module.group_lms_teacher'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="False"/>
    </record>

