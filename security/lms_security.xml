            <field name="model_id" ref="model_payment_transaction"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
            <!-- This is valid if partner_id is user.partner_id -->
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        </record>

