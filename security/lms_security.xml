            <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
            <field name="domain_force">[('student_id', '=', user.id)]</field>
        </record>

        <!-- Teacher can manage grades for their assigned courses -->
        <record id="rule_lms_grade_teacher" model="ir.rule">
            <field name="name">Teacher Grade Access</field>
            <field name="model_id" ref="model_lms_grade"/>
            <field name="groups" eval="[(4, ref('lms_module.group_lms_teacher'))]"/>
            <field name="domain_force">[('course_id.teacher_assignment_ids.teacher_id', '=', user.id)]</field>
        </record>

        <!-- Student can only see documents for courses in which they are enrolled -->
