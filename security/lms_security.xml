<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Student Profile Access for Regular Student Users: Now allow all records -->
    <record id="rule_lms_student_profile" model="ir.rule">
      <field name="name">Student Profile Access</field>
      <field name="model_id" ref="base.model_res_users"/>
      <!-- Remove the restriction so that all records are visible -->
      <field name="domain_force">[(1, '=', 1)]</field>
      <!-- You can keep the groups element so that only users in the Student group are affected if needed -->
      <field name="groups" eval="[(4, ref('lms_module.group_lms_student'))]"/>
    </record>

    <!-- Manager and Admin rules can remain as they are (they already have unrestricted access) -->
    <record id="rule_lms_student_profile_manager" model="ir.rule">
      <field name="name">Student Profile Manager Access</field>
      <field name="model_id" ref="base.model_res_users"/>
      <field name="groups" eval="[(4, ref('lms_module.group_lms_manager'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_lms_student_profile_admin" model="ir.rule">
      <field name="name">Student Profile Admin Access</field>
      <field name="model_id" ref="base.model_res_users"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>
  </data>
</odoo>
