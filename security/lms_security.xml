<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Define a module category for LMS if not already defined -->
    <record id="module_category_lms" model="ir.module.category">
      <field name="name">Learning Management</field>
      <field name="description">Manage learning activities and academic processes</field>
      <field name="sequence">50</field>
    </record>

    <!-- Student Group -->
    <record id="group_lms_student" model="res.groups">
      <field name="name">Student</field>
      <field name="category_id" ref="module_category_lms"/>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Record rule for student profiles for regular student users: they can only see their own record -->
    <record id="rule_lms_student_profile" model="ir.rule">
      <field name="name">Student Profile Access</field>
      <field name="model_id" ref="base.model_res_users"/>
      <field name="groups" eval="[(4, ref('group_lms_student'))]"/>
      <field name="domain_force">[('id', '=', user.id)]</field>
    </record>

    <!-- Record rule for managers (LMS Manager group) to see all student profiles -->
    <record id="rule_lms_student_profile_manager" model="ir.rule">
      <field name="name">Student Profile Manager Access</field>
      <field name="model_id" ref="base.model_res_users"/>
      <field name="groups" eval="[(4, ref('lms_module.group_lms_manager'))]"/>
      <field name="domain_force">[('is_student', '=', True)]</field>
    </record>

    <!-- Record rule for admin (base.group_system) to see all student profiles -->
    <record id="rule_lms_student_profile_admin" model="ir.rule">
      <field name="name">Student Profile Admin Access</field>
      <field name="model_id" ref="base.model_res_users"/>
      <field name="groups" eval="[(4, ref('base.group_system'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>
  </data>
</odoo>
