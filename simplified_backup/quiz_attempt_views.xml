<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Quiz Attempt Form View -->
        <record id="view_lms_quiz_attempt_form" model="ir.ui.view">
            <field name="name">lms.quiz.attempt.form</field>
            <field name="model">lms.quiz.attempt</field>
            <field name="arch" type="xml">
                <form string="Quiz Attempt">
                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="quiz_id"/>
                            <field name="student_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="score"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Quiz Attempt Tree View -->
        <record id="view_lms_quiz_attempt_tree" model="ir.ui.view">
            <field name="name">lms.quiz.attempt.tree</field>
            <field name="model">lms.quiz.attempt</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="quiz_id"/>
                    <field name="student_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="score"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Quiz Attempt Action -->
        <record id="action_lms_quiz_attempts" model="ir.actions.act_window">
            <field name="name">Quiz Attempts</field>
            <field name="res_model">lms.quiz.attempt</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Quiz Attempt Menu Item -->
        <menuitem id="menu_lms_quiz_attempts" name="Quiz Attempts"
                  parent="lms_module.menu_root"
                  action="action_lms_quiz_attempts"
                  sequence="10"/>
    </data>
</odoo> 