<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Quiz Question Attempt Form View -->
        <record id="view_lms_quiz_question_attempt_form" model="ir.ui.view">
            <field name="name">lms.quiz.question.attempt.form</field>
            <field name="model">lms.quiz.question.attempt</field>
            <field name="arch" type="xml">
                <form string="Question Attempt">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="attempt_id"/>
                                <field name="question_id"/>
                                <field name="sequence"/>
                                <field name="is_correct"/>
                            </group>
                            <group>
                                <field name="score"/>
                                <field name="max_score"/>
                                <field name="time_spent"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Answer" attrs="{'invisible': [('question_id', '=', False)]}">
                                <group>
                                    <field name="answer_text" attrs="{'invisible': [('question_id.question_type', 'not in', ['short_answer', 'essay'])]}"/>
                                    <field name="selected_option_ids" attrs="{'invisible': [('question_id.question_type', 'not in', ['multiple_choice', 'true_false'])]}">
                                        <tree>
                                            <field name="name"/>
                                            <field name="is_correct"/>
                                        </tree>
                                    </field>
                                </group>
                            </page>
                            <page string="Feedback">
                                <field name="feedback"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Quiz Question Attempt Tree View -->
        <record id="view_lms_quiz_question_attempt_tree" model="ir.ui.view">
            <field name="name">lms.quiz.question.attempt.tree</field>
            <field name="model">lms.quiz.question.attempt</field>
            <field name="arch" type="xml">
                <tree decoration-success="is_correct == True" decoration-danger="is_correct == False">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="attempt_id"/>
                    <field name="question_id"/>
                    <field name="score"/>
                    <field name="max_score"/>
                    <field name="is_correct"/>
                </tree>
            </field>
        </record>

        <!-- Quiz Question Attempt Search View -->
        <record id="view_lms_quiz_question_attempt_search" model="ir.ui.view">
            <field name="name">lms.quiz.question.attempt.search</field>
            <field name="model">lms.quiz.question.attempt</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="attempt_id"/>
                    <field name="question_id"/>
                    <separator/>
                    <filter string="Correct" name="correct" domain="[('is_correct', '=', True)]"/>
                    <filter string="Incorrect" name="incorrect" domain="[('is_correct', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Quiz Attempt" name="group_by_attempt" context="{'group_by': 'attempt_id'}"/>
                        <filter string="Question" name="group_by_question" context="{'group_by': 'question_id'}"/>
                        <filter string="Correctness" name="group_by_correct" context="{'group_by': 'is_correct'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Quiz Question Attempt Action -->
        <record id="action_lms_quiz_question_attempts" model="ir.actions.act_window">
            <field name="name">Question Attempts</field>
            <field name="res_model">lms.quiz.question.attempt</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_quiz_question_attempt_search"/>
        </record>
    </data>
</odoo> 