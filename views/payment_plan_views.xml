<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- =============================== -->
        <!-- 1) TREE VIEW: lms.payment.plan -->
        <!-- =============================== -->
        <record id="view_lms_payment_plan_tree" model="ir.ui.view">
            <field name="name">lms.payment.plan.tree</field>
            <field name="model">lms.payment.plan</field>
            <field name="arch" type="xml">
                <!-- 
                  Decorate rows based on state if desired. 
                  e.g. decoration-info for 'pending', decoration-success for 'paid'
                -->
                <tree decoration-info="state == 'pending'" 
                      decoration-success="state == 'paid'"
                      decoration-muted="state == 'archived'">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="student_id"/>
                    <field name="enrollment_id"/>
                    <field name="total_amount"/>
                    <field name="paid_amount"/>
                    <field name="remaining_amount"/>
                    <field name="number_of_installments"/>
                    <field name="installment_amount"/>
                    <field name="payment_frequency"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- =============================== -->
        <!-- 2) FORM VIEW: lms.payment.plan -->
        <!-- =============================== -->
        <record id="view_lms_payment_plan_form" model="ir.ui.view">
            <field name="name">lms.payment.plan.form</field>
            <field name="model">lms.payment.plan</field>
            <field name="arch" type="xml">
                <form string="Payment Plan">
                    <header>
                        <!-- Buttons controlling state transitions -->
                        <button name="action_confirm" string="Confirm" type="object" class="oe_highlight"
                                attrs="{'invisible':[('state','!=','draft')]}" />
                        <button name="action_mark_paid" string="Mark as Paid" type="object"
                                attrs="{'invisible':[('state','not in',['pending'])]}" />
                        <button name="action_archive" string="Archive" type="object"
                                attrs="{'invisible':[('state','not in',['paid','pending'])]}" />
                        <field name="state" widget="statusbar" 
                               statusbar_visible="draft,pending,paid,archived"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Payment Plan Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="admin_id" domain="[('is_admin','=',True)]"/>
                                <field name="enrollment_id"/>
                                <field name="student_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="total_amount" required="1"/>
                                <field name="paid_amount"/>
                                <field name="remaining_amount" readonly="1"/>
                                <field name="due_date"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="number_of_installments" required="1"/>
                                <field name="installment_amount" readonly="1"/>
                                <field name="payment_frequency" required="1"/>
                                <field name="payment_method"/>
                            </group>
                            <group>
                                <field name="description"/>
                                <field name="notes"/>
                                <field name="active"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Payments">
                                <field name="payment_ids">
                                    <tree>
                                        <field name="date"/>
                                        <field name="amount"/>
                                        <field name="payment_method"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    
                    <!-- Chatter, if needed (mail.thread, mail.activity.mixin) -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- =============================== -->
        <!-- 3) SEARCH VIEW: lms.payment.plan -->
        <!-- =============================== -->
        <record id="view_lms_payment_plan_search" model="ir.ui.view">
            <field name="name">lms.payment.plan.search</field>
            <field name="model">lms.payment.plan</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="admin_id"/>
                    <field name="enrollment_id"/>
                    <field name="student_id"/>
                    <field name="state"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Pending" name="pending" domain="[('state','=','pending')]"/>
                    <filter string="Paid" name="paid" domain="[('state','=','paid')]"/>
                    <filter string="Archived" name="archived" domain="[('state','=','archived')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Administrator" name="group_by_admin" context="{'group_by':'admin_id'}"/>
                        <filter string="Student" name="group_by_student" context="{'group_by':'student_id'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- =============================== -->
        <!-- 4) ACTION: lms.payment.plan    -->
        <!-- =============================== -->
        <record id="action_lms_payment_plan" model="ir.actions.act_window">
            <field name="name">Payment Plans</field>
            <field name="res_model">lms.payment.plan</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_payment_plan_search"/>
        </record>

        <!-- 
          If you keep menus in a separate file, 
          just reference action_lms_payment_plan there, e.g.:
          
          <menuitem id="menu_lms_payment_plans"
                    name="Payment Plans"
                    parent="lms_module.menu_root"
                    action="action_lms_payment_plan"
                    sequence="10"/>
        -->

    </data>
</odoo>
