<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- ✅ Enrollment Form View -->
        <record id="view_lms_enrollment_form" model="ir.ui.view">
            <field name="name">lms.enrollment.form</field>
            <field name="model">lms.enrollment</field>
            <field name="arch" type="xml">
                <form string="Enrollment" class="lms_module o_form_view">
                    <header>
                        <field name="payment_status" widget="statusbar" statusbar_visible="pending,partial,paid" options="{'clickable': '1'}"/>
                        <button name="make_payment"
                                type="object"
                                string="Make Payment"
                                class="btn-primary"
                                attrs="{'invisible': [('payment_status','=', 'paid')]}" />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>Enrollment #<field name="name" class="oe_inline" readonly="1"/></h1>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <group>
                                    <field name="student_id" required="1" options="{'no_create': True}"/>
                                    <field name="enrollment_date" required="1"/>
                                </group>
                            </div>
                            <div class="col-md-6">
                                <group>
                                    <field name="total_cost" readonly="1" widget="monetary"/>
                                    <field name="remaining_balance" readonly="1" widget="monetary"/>
                                </group>
                            </div>
                        </div>
                        <notebook>
                            <page string="Courses" name="courses">
                                <field name="course_id" widget="many2many_tags" options="{'color_field': 'color'}" required="1"/>
                            </page>
                            <page string="Payments" name="payments">
                                <field name="payment_ids" widget="one2many">
                                    <tree>
                                        <field name="payment_date"/>
                                        <field name="amount" sum="Total"/>
                                        <field name="payment_method"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ✅ Enrollment Tree View -->
        <record id="view_lms_enrollment_tree" model="ir.ui.view">
            <field name="name">lms.enrollment.tree</field>
            <field name="model">lms.enrollment</field>
            <field name="arch" type="xml">
                <tree class="lms_module o_list_view" decoration-danger="payment_status=='pending'" decoration-warning="payment_status=='partial'" decoration-success="payment_status=='paid'">
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="course_id" widget="many2many_tags"/>
                    <field name="enrollment_date"/>
                    <field name="payment_status" widget="badge" decoration-danger="payment_status=='pending'" decoration-warning="payment_status=='partial'" decoration-success="payment_status=='paid'"/>
                    <field name="total_cost" sum="Total" widget="monetary"/>
                    <field name="remaining_balance" sum="Balance" widget="monetary"/>
                </tree>
            </field>
        </record>

        <!-- ✅ Enrollment Search View -->
        <record id="view_lms_enrollment_search" model="ir.ui.view">
            <field name="name">lms.enrollment.search</field>
            <field name="model">lms.enrollment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="enrollment_date"/>
                    <field name="payment_status"/>
                    <filter name="pending_payments" string="Pending Payments" domain="[('payment_status','=','pending')]"/>
                    <filter name="partial_payments" string="Partial Payments" domain="[('payment_status','=','partial')]"/>
                    <filter name="paid" string="Fully Paid" domain="[('payment_status','=','paid')]"/>
                    <filter name="current_month" string="Current Month" domain="[('enrollment_date', '&gt;=', context_today().strftime('%Y-%m-01')), ('enrollment_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_student" string="Student" context="{'group_by': 'student_id'}"/>
                        <filter name="group_by_payment_status" string="Payment Status" context="{'group_by': 'payment_status'}"/>
                        <filter name="group_by_enrollment_date" string="Enrollment Date" context="{'group_by': 'enrollment_date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ✅ Enrollment Kanban View -->
        <record id="view_lms_enrollment_kanban" model="ir.ui.view">
            <field name="name">lms.enrollment.kanban</field>
            <field name="model">lms.enrollment</field>
            <field name="arch" type="xml">
                <kanban class="lms_module o_kanban_view" default_group_by="payment_status">
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="enrollment_date"/>
                    <field name="payment_status"/>
                    <field name="total_cost"/>
                    <field name="remaining_balance"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <span><field name="name"/></span>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="student_id"/>
                                    </div>
                                    <div>
                                        <span class="text-muted">Enrollment Date: </span>
                                        <field name="enrollment_date"/>
                                    </div>
                                    <div class="mt-2">
                                        <span t-if="record.payment_status.raw_value == 'pending'" class="badge badge-danger">
                                            Pending Payment
                                        </span>
                                        <span t-if="record.payment_status.raw_value == 'partial'" class="badge badge-warning">
                                            Partial Payment
                                        </span>
                                        <span t-if="record.payment_status.raw_value == 'paid'" class="badge badge-success">
                                            Fully Paid
                                        </span>
                                    </div>
                                    <div class="mt-2">
                                        <span class="text-muted">Total: </span>
                                        <field name="total_cost" widget="monetary"/>
                                    </div>
                                    <div t-if="record.payment_status.raw_value != 'paid'">
                                        <span class="text-muted">Balance: </span>
                                        <field name="remaining_balance" widget="monetary"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ✅ Enrollment Action -->
        <record id="action_lms_enrollment" model="ir.actions.act_window">
            <field name="name">Enrollments</field>
            <field name="res_model">lms.enrollment</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_lms_enrollment_search"/>
            <field name="context">{'search_default_group_by_payment_status': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first enrollment!
                </p>
                <p>
                    Enrollments record students in courses and track payment status.
                </p>
            </field>
        </record>

        <!-- ✅ Menu Item under LMS Module -->
        <menuitem id="menu_lms_enrollment"
                  name="Enrollments"
                  parent="lms_module.menu_root"
                  action="action_lms_enrollment"
                  sequence="8"/>
    </data>
</odoo>