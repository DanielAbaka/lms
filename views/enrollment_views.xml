<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Enrollment Form View -->
        <record id="view_lms_enrollment_form" model="ir.ui.view">
            <field name="name">lms.enrollment.form</field>
            <field name="model">lms.enrollment</field>
            <field name="arch" type="xml">
                <form string="Enrollment">
                    <header>
                        <button name="action_import_students" string="Import Students" type="object" class="oe_highlight"/>
                        <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" states="draft"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <field name="total_students" widget="statinfo" string="Total Students"/>
                            <field name="confirmed_count" widget="statinfo" string="Confirmed"/>
                            <field name="pending_count" widget="statinfo" string="Pending"/>
                        </div>
                        <notebook>
                            <page string="Enrollment Details">
                                <group>
                                    <group>
                                        <field name="course_id" required="1"/>
                                        <field name="batch_id"/>
                                        <field name="enrollment_date" required="1"/>
                                        <field name="state"/>
                                    </group>
                                    <group>
                                        <field name="total_students"/>
                                        <field name="confirmed_count"/>
                                        <field name="pending_count"/>
                                        <field name="payment_status"/>
                                    </group>
                                </group>
                                <group string="Notes">
                                    <field name="notes"/>
                                </group>
                            </page>
                            <page string="Students">
                                <field name="student_ids">
                                    <tree editable="bottom">
                                        <field name="student_id"/>
                                        <field name="status"/>
                                        <field name="payment_status"/>
                                        <field name="enrollment_date"/>
                                        <field name="notes"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Payment Plans">
                                <field name="payment_plan_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="amount"/>
                                        <field name="due_date"/>
                                        <field name="status"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Enrollment Tree View -->
        <record id="view_lms_enrollment_tree" model="ir.ui.view">
            <field name="name">lms.enrollment.tree</field>
            <field name="model">lms.enrollment</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state == 'confirmed'">
                    <field name="course_id"/>
                    <field name="batch_id"/>
                    <field name="enrollment_date"/>
                    <field name="total_students"/>
                    <field name="confirmed_count"/>
                    <field name="payment_status"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Enrollment Search View -->
        <record id="view_lms_enrollment_search" model="ir.ui.view">
            <field name="name">lms.enrollment.search</field>
            <field name="model">lms.enrollment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="course_id"/>
                    <field name="batch_id"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <filter string="Pending Payment" name="pending_payment" domain="[('payment_status', '=', 'pending')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}"/>
                        <filter string="Batch" name="group_by_batch" context="{'group_by': 'batch_id'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Enrollment Actions -->
        <record id="action_lms_enrollments" model="ir.actions.act_window">
            <field name="name">Enrollments</field>
            <field name="res_model">lms.enrollment</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_enrollment_search"/>
        </record>

        <!-- Enrollment Menu -->
        <menuitem id="menu_lms_enrollments"
                  name="Enrollments"
                  parent="lms_module.menu_root"
                  action="action_lms_enrollments"
                  sequence="5"/>
    </data>
</odoo>