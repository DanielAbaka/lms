<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Document Access Form View -->
        <record id="view_lms_document_access_form" model="ir.ui.view">
            <field name="name">lms.document.access.form</field>
            <field name="model">lms.document.access</field>
            <field name="arch" type="xml">
                <form string="Document Access">
                    <sheet>
                        <group>
                            <group>
                                <field name="document_id" required="1"/>
                                <field name="user_id" required="1"/>
                                <field name="access_date" required="1"/>
                            </group>
                            <group>
                                <field name="ip_address"/>
                                <field name="user_agent"/>
                                <field name="duration"/>
                                <field name="is_downloaded"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Document Access Tree View -->
        <record id="view_lms_document_access_tree" model="ir.ui.view">
            <field name="name">lms.document.access.tree</field>
            <field name="model">lms.document.access</field>
            <field name="arch" type="xml">
                <tree decoration-info="is_downloaded == False" decoration-success="is_downloaded == True">
                    <field name="document_id"/>
                    <field name="user_id"/>
                    <field name="access_date"/>
                    <field name="ip_address"/>
                    <field name="user_agent"/>
                    <field name="duration"/>
                    <field name="is_downloaded"/>
                </tree>
            </field>
        </record>

        <!-- Document Access Search View -->
        <record id="view_lms_document_access_search" model="ir.ui.view">
            <field name="name">lms.document.access.search</field>
            <field name="model">lms.document.access</field>
            <field name="arch" type="xml">
                <search>
                    <field name="document_id"/>
                    <field name="user_id"/>
                    <field name="ip_address"/>
                    <field name="user_agent"/>
                    <separator/>
                    <filter string="Downloaded" name="downloaded" domain="[('is_downloaded', '=', True)]"/>
                    <filter string="Not Downloaded" name="not_downloaded" domain="[('is_downloaded', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Document" name="group_by_document" context="{'group_by': 'document_id'}"/>
                        <filter string="User" name="group_by_user" context="{'group_by': 'user_id'}"/>
                        <filter string="Download Status" name="group_by_download" context="{'group_by': 'is_downloaded'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Document Access Action -->
        <record id="action_lms_document_access" model="ir.actions.act_window">
            <field name="name">Document Access Logs</field>
            <field name="res_model">lms.document.access</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_document_access_search"/>
        </record>

        <!-- Document Access Menu Item -->
        <menuitem id="menu_lms_document_access" name="Document Access Logs"
                  parent="lms_module.menu_root"
                  action="action_lms_document_access"
                  sequence="11"/>
    </data>
</odoo> 