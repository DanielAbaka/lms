<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================== -->
        <!-- 1) TREE VIEW: lms.transcript -->
        <!-- ========================== -->
        <record id="view_lms_transcript_tree" model="ir.ui.view">
            <field name="name">lms.transcript.tree</field>
            <field name="model">lms.transcript</field>
            <field name="arch" type="xml">
                <tree>
                    <!-- Show fields you want in the list view, e.g.: -->
                    <field name="student_id"/>
                    <field name="academic_year_id"/>
                    <field name="semester_id"/>
                    <field name="total_credits"/>
                    <field name="gpa"/>
                </tree>
            </field>
        </record>

        <!-- ========================== -->
        <!-- 2) FORM VIEW: lms.transcript -->
        <!-- ========================== -->
        <record id="view_lms_transcript_form" model="ir.ui.view">
            <field name="name">lms.transcript.form</field>
            <field name="model">lms.transcript</field>
            <field name="arch" type="xml">
                <form string="Student Transcript">
                    <sheet>
                        <group>
                            <field name="student_id" required="1"/>
                            <field name="academic_year_id"/>
                            <field name="semester_id"/>
                            <field name="total_credits" readonly="1"/>
                            <field name="gpa" readonly="1"/>
                        </group>
                        <group string="Courses">
                            <!-- If you want a tags widget or a tree for many2many, you can choose: -->
                            <field name="course_ids" widget="many2many_tags"/>
                            <!-- Alternatively:
                            <field name="course_ids" mode="tree" >
                                <tree>
                                    <field name="name"/>
                                    <field name="credits"/>
                                </tree>
                            </field>
                            -->
                        </group>
                    </sheet>
                    <!-- Chatter if you want to enable mail.thread on this model -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ========================== -->
        <!-- 3) SEARCH VIEW: lms.transcript -->
        <!-- ========================== -->
        <record id="view_lms_transcript_search" model="ir.ui.view">
            <field name="name">lms.transcript.search</field>
            <field name="model">lms.transcript</field>
            <field name="arch" type="xml">
                <search>
                    <field name="student_id"/>
                    <field name="academic_year_id"/>
                    <field name="semester_id"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Student" name="group_by_student" context="{'group_by':'student_id'}"/>
                        <filter string="Academic Year" name="group_by_academic_year" context="{'group_by':'academic_year_id'}"/>
                        <filter string="Semester" name="group_by_semester" context="{'group_by':'semester_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ========================== -->
        <!-- 4) ACTION: lms.transcript -->
        <!-- ========================== -->
        <record id="action_lms_transcript" model="ir.actions.act_window">
            <field name="name">Transcripts</field>
            <field name="res_model">lms.transcript</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_transcript_search"/>
        </record>

        <!-- 
          If you manage menus in another XML file, reference "action_lms_transcript" there, e.g.:
          
          <menuitem id="menu_lms_transcripts"
                    name="Transcripts"
                    parent="lms_module.menu_root"
                    action="action_lms_transcript"
                    sequence="50"/>
        -->

    </data>
</odoo>
