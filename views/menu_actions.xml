<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Course Schedules Action -->
        <record id="action_lms_course_schedules" model="ir.actions.act_window">
            <field name="name">Course Schedules</field>
            <field name="res_model">lms.schedule</field>
            <field name="view_mode">tree,form,calendar</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first course schedule
                </p>
            </field>
        </record>

        <!-- Course Enrollments Action -->
        <record id="action_lms_course_enrollments" model="ir.actions.act_window">
            <field name="name">Course Enrollments</field>
            <field name="res_model">lms.enrollment</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first course enrollment
                </p>
            </field>
        </record>

        <!-- Teacher Portal Attendance Action -->
        <record id="action_teacher_portal_attendance" model="ir.actions.act_window">
            <field name="name">Course Attendance</field>
            <field name="res_model">lms.attendance</field>
            <field name="view_mode">tree,form,calendar</field>
            <field name="domain">[('marked_by', '=', uid)]</field>
            <field name="context">{'default_marked_by': uid}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first attendance record
                </p>
            </field>
        </record>

        <!-- Course Grades Action -->
        <record id="action_lms_course_grades" model="ir.actions.act_window">
            <field name="name">Course Grades</field>
            <field name="res_model">lms.grade</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first grade record
                </p>
            </field>
        </record>

        <!-- Course Quizzes Action -->
        <record id="action_lms_course_quizzes" model="ir.actions.act_window">
            <field name="name">Course Quizzes</field>
            <field name="res_model">lms.quiz</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first quiz
                </p>
            </field>
        </record>

        <!-- Quiz Questions Action -->
        <record id="action_lms_quiz_questions" model="ir.actions.act_window">
            <field name="name">Quiz Questions</field>
            <field name="res_model">lms.quiz.question</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first quiz question
                </p>
            </field>
        </record>

        <!-- LMS Config Action -->
        <record id="action_lms_config" model="ir.actions.act_window">
            <field name="name">LMS Settings</field>
            <field name="res_model">lms.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module': 'lms_module'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Configure LMS settings
                </p>
            </field>
        </record>

        <!-- LMS Course Materials Action -->
        <record id="action_lms_course_materials" model="ir.actions.act_window">
            <field name="name">Course Materials</field>
            <field name="res_model">lms.course.material</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first course material
                </p>
            </field>
        </record>

        <!-- LMS Attendance Action -->
        <record id="action_lms_attendance" model="ir.actions.act_window">
            <field name="name">Attendance</field>
            <field name="res_model">lms.attendance</field>
            <field name="view_mode">tree,form,calendar</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first attendance record
                </p>
            </field>
        </record>
    </data>
</odoo> 