<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Academic Year Form View -->
    <record id="view_lms_academic_year_form" model="ir.ui.view">
      <field name="name">lms.academic.year.form</field>
      <field name="model">lms.academic.year</field>
      <field name="arch" type="xml">
        <form string="Academic Year">
          <header>
            <button name="action_activate" string="Activate" type="object" class="oe_highlight" invisible="state != 'draft'"/>
            <button name="action_complete" string="Complete" type="object" class="oe_highlight" invisible="state != 'active'"/>
            <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft','active')"/>
            <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
            <field name="state" widget="statusbar"/>
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button name="action_view_semesters" type="object" class="oe_stat_button" icon="fa-calendar">
                <field name="semester_count" widget="statinfo" string="Semesters"/>
              </button>
              <button name="action_view_courses" type="object" class="oe_stat_button" icon="fa-book">
                <field name="course_count" widget="statinfo" string="Courses"/>
              </button>
              <button name="action_view_students" type="object" class="oe_stat_button" icon="fa-users">
                <field name="student_count" widget="statinfo" string="Students"/>
              </button>
              <button name="action_view_teachers" type="object" class="oe_stat_button" icon="fa-user-md">
                <field name="teacher_count" widget="statinfo" string="Teachers"/>
              </button>
            </div>
            <notebook>
              <page string="General Information">
                <group>
                  <group>
                    <field name="name" required="1"/>
                    <field name="code" required="1"/>
                    <field name="start_date" required="1"/>
                    <field name="end_date" required="1"/>
                    <field name="state"/>
                  </group>
                  <group>
                    <field name="active"/>
                  </group>
                </group>
              </page>
              <page string="Semesters">
                <field name="semester_ids">
                  <tree editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="state"/>
                  </tree>
                </field>
              </page>
              <page string="Courses">
                <field name="course_ids">
                  <tree>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="credits"/>
                    <field name="enrollment_count"/>
                    <field name="state"/>
                  </tree>
                </field>
              </page>
              <page string="Teacher Assignments">
                <field name="teacher_assignment_ids">
                  <tree>
                    <field name="teacher_id"/>
                    <field name="course_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="state"/>
                  </tree>
                </field>
              </page>
              <page string="Enrollments">
                <field name="enrollment_ids">
                  <tree>
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="enrollment_date"/>
                    <field name="state"/>
                  </tree>
                </field>
              </page>
              <page string="Quizzes">
                <field name="quiz_ids">
                  <tree>
                    <field name="name"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="state"/>
                  </tree>
                </field>
              </page>
              <page string="Grades">
                <field name="grade_ids">
                  <tree>
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="grade"/>
                    <field name="state"/>
                  </tree>
                </field>
              </page>
              <page string="Documents">
                <field name="document_ids">
                  <tree>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="state"/>
                  </tree>
                </field>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
          </div>
        </form>
      </field>
    </record>

    <!-- Quiz Preview View -->
    <record id="view_lms_quiz_preview" model="ir.ui.view">
      <field name="name">lms.quiz.preview</field>
      <field name="model">lms.quiz</field>
      <field name="arch" type="xml">
        <form string="Quiz Preview">
          <header>
            <button name="action_publish" string="Publish" type="object" class="oe_highlight" invisible="state != 'draft'"/>
            <button name="action_start" string="Start" type="object" class="oe_highlight" invisible="state != 'published'"/>
            <button name="action_complete" string="Complete" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
            <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft','published')"/>
            <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
            <field name="state" widget="statusbar"/>
          </header>
          <sheet>
            <div class="oe_title">
              <h1><field name="name"/></h1>
              <h2><field name="description"/></h2>
            </div>
            <notebook>
              <page string="Statistics">
                <group>
                  <group>
                    <field name="attempt_count"/>
                    <field name="average_score"/>
                    <field name="pass_rate"/>
                  </group>
                </group>
              </page>
              <page string="Settings">
                <group>
                  <group>
                    <field name="duration"/>
                    <field name="passing_score"/>
                    <field name="max_attempts"/>
                  </group>
                  <group>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="state"/>
                  </group>
                </group>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Course Kanban View -->
    <record id="view_lms_course_kanban" model="ir.ui.view">
      <field name="name">lms.course.kanban</field>
      <field name="model">slide.channel</field>
      <field name="arch" type="xml">
        <kanban class="oe_background_grey" sample="1">
          <field name="image_1920" widget="image"/>
          <field name="name"/>
          <field name="code"/>
          <field name="enrollment_count"/>
          <field name="state"/>
          <templates>
            <t t-name="kanban-box">
              <div class="oe_kanban_global_click">
                <div class="oe_kanban_image">
                  <img t-att-src="kanban_image('slide.channel', 'image_1920', record.id.raw_value)" alt="Course Image"/>
                </div>
                <div class="oe_kanban_details">
                  <strong class="oe_kanban_record_title">
                    <field name="name"/>
                  </strong>
                  <div class="oe_kanban_record_subtitle">
                    <field name="code"/>
                  </div>
                  <div class="oe_kanban_record_bottom">
                    <div class="oe_kanban_record_bottom_left">
                      <span><field name="enrollment_count"/> students</span>
                    </div>
                    <div class="oe_kanban_record_bottom_right">
                      <field name="state" widget="label_selection"/>
                    </div>
                  </div>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <!-- Course Form View -->
    <record id="view_lms_course_form" model="ir.ui.view">
      <field name="name">lms.course.form</field>
      <field name="model">slide.channel</field>
      <field name="arch" type="xml">
        <form string="Course">
          <header>
            <field name="state" widget="statusbar"/>
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button name="action_view_enrollments" type="object" class="oe_stat_button" icon="fa-users">
                <field name="enrollment_count" widget="statinfo" string="Enrollments"/>
              </button>
              <button name="action_view_assignments" type="object" class="oe_stat_button" icon="fa-tasks">
                <field name="assignment_count" widget="statinfo" string="Assignments"/>
              </button>
            </div>
            <notebook>
              <page string="Course Details">
                <group>
                  <group>
                    <field name="name" required="1"/>
                    <field name="code" required="1"/>
                    <field name="credits"/>
                    <field name="max_students"/>
                  </group>
                  <group>
                    <field name="academic_year_id"/>
                    <field name="semester_id"/>
                    <field name="state"/>
                  </group>
                </group>
                <group string="Description">
                  <field name="description"/>
                  <field name="objectives"/>
                  <field name="prerequisites"/>
                </group>
              </page>
              <page string="Enrollments">
                <field name="enrollment_ids">
                  <tree>
                    <field name="student_id"/>
                    <field name="enrollment_date"/>
                    <field name="state"/>
                  </tree>
                </field>
              </page>
              <page string="Teacher Assignments">
                <field name="teacher_assignment_ids">
                  <tree>
                    <field name="teacher_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="state"/>
                  </tree>
                </field>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
          </div>
        </form>
      </field>
    </record>

    <!-- Course Tree View -->
    <record id="view_lms_course_tree" model="ir.ui.view">
      <field name="name">lms.course.tree</field>
      <field name="model">slide.channel</field>
      <field name="arch" type="xml">
        <tree decoration-info="state == 'draft'" decoration-success="state == 'published'">
          <field name="name"/>
          <field name="code"/>
          <field name="academic_year_id"/>
          <field name="semester_id"/>
          <field name="credits"/>
          <field name="max_students"/>
          <field name="enrollment_count"/>
          <field name="assignment_count"/>
          <field name="state"/>
        </tree>
      </field>
    </record>

    <!-- Course Search View -->
    <record id="view_lms_course_search" model="ir.ui.view">
      <field name="name">lms.course.search</field>
      <field name="model">slide.channel</field>
      <field name="arch" type="xml">
        <search>
          <field name="name"/>
          <field name="code"/>
          <field name="academic_year_id"/>
          <field name="semester_id"/>
          <field name="credits"/>
          <separator/>
          <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
          <filter string="Published" name="published" domain="[('state', '=', 'published')]"/>
          <group expand="0" string="Group By">
            <filter string="Academic Year" name="group_by_academic_year" context="{'group_by': 'academic_year_id'}"/>
            <filter string="Semester" name="group_by_semester" context="{'group_by': 'semester_id'}"/>
            <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- Enrollment Form View -->
    <record id="view_lms_enrollment_form" model="ir.ui.view">
      <field name="name">lms.enrollment.form</field>
      <field name="model">lms.enrollment</field>
      <field name="arch" type="xml">
        <form string="Enrollment">
          <header>
            <button name="action_submit_for_approval" string="Submit for Approval" type="object" class="oe_highlight" invisible="state != 'draft'"/>
            <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'pending'"/>
            <button name="action_reject" string="Reject" type="object" invisible="state != 'pending'"/>
            <button name="action_cancel" string="Cancel" type="object" invisible="state in ('cancelled', 'rejected')"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,rejected,cancelled"/>
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money">
                <field name="paid_amount" widget="monetary"/>
              </button>
              <button name="action_view_grades" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                <span>Grades</span>
              </button>
              <button name="action_view_attendance" type="object" class="oe_stat_button" icon="fa-calendar-check-o">
                <span>Attendance</span>
              </button>
            </div>
            <group>
              <group>
                <field name="name" readonly="1"/>
                <field name="student_id" readonly="state != 'draft'"/>
                <field name="course_id" readonly="state != 'draft'"/>
                <field name="academic_year_id" readonly="state != 'draft'"/>
                <field name="semester_id" readonly="state != 'draft'"/>
                <field name="enrollment_date" readonly="state != 'draft'"/>
              </group>
              <group>
                <field name="start_date" readonly="state != 'draft'"/>
                <field name="end_date" readonly="state != 'draft'"/>
                <field name="total_fee" readonly="state != 'draft'"/>
                <field name="paid_amount" readonly="1"/>
                <field name="remaining_amount" readonly="1"/>
                <field name="payment_status" readonly="1"/>
                <field name="state" invisible="1"/>
              </group>
            </group>
            <notebook>
              <page string="Payments">
                <field name="payment_ids">
                  <tree>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="amount"/>
                    <field name="payment_method"/>
                    <field name="state"/>
                  </tree>
                </field>
              </page>
              <page string="Grades">
                <field name="grade_ids">
                  <tree>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="grade"/>
                    <field name="grade_type"/>
                    <field name="state"/>
                  </tree>
                </field>
              </page>
              <page string="Attendance">
                <field name="attendance_ids">
                  <tree>
                    <field name="date"/>
                    <field name="status"/>
                    <field name="notes"/>
                  </tree>
                </field>
              </page>
              <page string="Notes">
                <field name="notes"/>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
          </div>
        </form>
      </field>
    </record>

    <!-- Enrollment Tree View -->
    <record id="view_lms_enrollment_tree" model="ir.ui.view">
      <field name="name">lms.enrollment.tree</field>
      <field name="model">lms.enrollment</field>
      <field name="arch" type="xml">
        <tree decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-muted="state == 'cancelled'">
          <field name="name"/>
          <field name="student_id"/>
          <field name="course_id"/>
          <field name="academic_year_id"/>
          <field name="semester_id"/>
          <field name="enrollment_date"/>
          <field name="total_fee"/>
          <field name="paid_amount"/>
          <field name="payment_status"/>
          <field name="state"/>
        </tree>
      </field>
    </record>

    <!-- Enrollment Search View -->
    <record id="view_lms_enrollment_search" model="ir.ui.view">
      <field name="name">lms.enrollment.search</field>
      <field name="model">lms.enrollment</field>
      <field name="arch" type="xml">
        <search>
          <field name="name"/>
          <field name="student_id"/>
          <field name="course_id"/>
          <field name="academic_year_id"/>
          <field name="semester_id"/>
          <separator/>
          <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
          <filter string="Pending Approval" name="pending" domain="[('state', '=', 'pending')]"/>
          <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
          <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
          <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
          <separator/>
          <filter string="Pending Payment" name="pending_payment" domain="[('payment_status', '=', 'pending')]"/>
          <filter string="Partial Payment" name="partial_payment" domain="[('payment_status', '=', 'partial')]"/>
          <filter string="Paid" name="paid" domain="[('payment_status', '=', 'paid')]"/>
          <group expand="0" string="Group By">
            <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}"/>
            <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}"/>
            <filter string="Academic Year" name="group_by_academic_year" context="{'group_by': 'academic_year_id'}"/>
            <filter string="Semester" name="group_by_semester" context="{'group_by': 'semester_id'}"/>
            <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
            <filter string="Payment Status" name="group_by_payment_status" context="{'group_by': 'payment_status'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- Grade Form View -->
    <record id="view_lms_grade_form" model="ir.ui.view">
      <field name="name">lms.grade.form</field>
      <field name="model">lms.grade</field>
      <field name="arch" type="xml">
        <form string="Grade">
          <header>
            <button name="action_submit_grade" string="Submit Grade" type="object" class="oe_highlight" invisible="state != 'draft'"/>
            <button name="action_reset_grade" type="object" string="Reset" invisible="state != 'submitted'"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,submitted,confirmed"/>
          </header>
          <sheet>
            <div class="oe_title">
              <h1><field name="name" readonly="1"/></h1>
            </div>
            <group>
              <group>
                <field name="student_id" required="1" readonly="state != 'draft'"/>
                <field name="enrollment_id" required="1" readonly="state != 'draft'"/>
                <field name="course_id" required="1" readonly="state != 'draft'"/>
                <field name="quiz_id" readonly="state != 'draft'"/>
                <field name="teacher_assignment_id" readonly="state != 'draft'"/>
              </group>
              <group>
                <field name="grade" required="1" readonly="state != 'draft'"/>
                <field name="grade_type" required="1" readonly="state != 'draft'"/>
                <field name="credits" required="1" readonly="state != 'draft'"/>
                <field name="is_final" readonly="state != 'draft'"/>
                <field name="date" readonly="state != 'draft'"/>
                <field name="state" invisible="1"/>
              </group>
            </group>
            <notebook>
              <page string="Comments">
                <field name="remarks" readonly="state != 'draft'"/>
              </page>
              <page string="Grading Information" invisible="not grading_date">
                <group>
                  <group>
                    <field name="graded_by" readonly="1"/>
                    <field name="grading_date" readonly="1"/>
                  </group>
                </group>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
          </div>
        </form>
      </field>
    </record>

    <!-- Grade Tree View -->
    <record id="view_lms_grade_tree" model="ir.ui.view">
      <field name="name">lms.grade.tree</field>
      <field name="model">lms.grade</field>
      <field name="arch" type="xml">
        <tree decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-muted="state == 'submitted'">
          <field name="name"/>
          <field name="student_id"/>
          <field name="course_id"/>
          <field name="grade"/>
          <field name="grade_type"/>
          <field name="credits"/>
          <field name="date"/>
          <field name="is_final"/>
          <field name="state"/>
        </tree>
      </field>
    </record>

    <!-- Grade Search View -->
    <record id="view_lms_grade_search" model="ir.ui.view">
      <field name="name">lms.grade.search</field>
      <field name="model">lms.grade</field>
      <field name="arch" type="xml">
        <search>
          <field name="name"/>
          <field name="student_id"/>
          <field name="course_id"/>
          <field name="grade"/>
          <field name="date"/>
          <field name="grade_type"/>
          <separator/>
          <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
          <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
          <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
          <separator/>
          <filter string="Final Grades" name="is_final" domain="[('is_final', '=', True)]"/>
          <filter string="Quiz Grades" name="quiz_grades" domain="[('grade_type', '=', 'quiz')]"/>
          <filter string="Exam Grades" name="exam_grades" domain="[('grade_type', '=', 'exam')]"/>
          <filter string="Assignment Grades" name="assignment_grades" domain="[('grade_type', '=', 'assignment')]"/>
          <group expand="0" string="Group By">
            <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}"/>
            <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}"/>
            <filter string="Grade Type" name="group_by_grade_type" context="{'group_by': 'grade_type'}"/>
            <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
            <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- Grade Action -->
    <record id="action_lms_grade" model="ir.actions.act_window">
      <field name="name">Grades</field>
      <field name="res_model">lms.grade</field>
      <field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="view_lms_grade_search"/>
    </record>

    <!-- Transcript Form View -->
    <record id="view_lms_transcript_form" model="ir.ui.view">
      <field name="name">lms.transcript.form</field>
      <field name="model">lms.transcript</field>
      <field name="arch" type="xml">
        <form string="Transcript">
          <header>
            <button name="action_activate" string="Activate" type="object" class="oe_highlight" invisible="state != 'draft'"/>
            <button name="action_complete" string="Complete" type="object" class="oe_highlight" invisible="state != 'active'"/>
            <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'active')"/>
            <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
            <field name="state" widget="statusbar"/>
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button name="action_view_grades" type="object" class="oe_stat_button" icon="fa-star">
                <field name="grade_count" widget="statinfo" string="Grades"/>
              </button>
              <button name="action_view_courses" type="object" class="oe_stat_button" icon="fa-book">
                <field name="course_count" widget="statinfo" string="Courses"/>
              </button>
            </div>
            <notebook>
              <page string="General Information">
                <group>
                  <group>
                    <field name="student_id" required="1"/>
                    <field name="academic_year_id" required="1"/>
                    <field name="semester_id" required="1"/>
                    <field name="state"/>
                  </group>
                  <group>
                    <field name="gpa"/>
                    <field name="total_credits"/>
                    <field name="active"/>
                  </group>
                </group>
              </page>
              <page string="Academic Summary">
                <group>
                  <group>
                    <field name="total_courses"/>
                    <field name="courses_completed"/>
                    <field name="courses_in_progress"/>
                    <field name="courses_failed"/>
                  </group>
                  <group>
                    <field name="total_credits_attempted"/>
                    <field name="total_credits_earned"/>
                    <field name="total_credits_in_progress"/>
                    <field name="total_credits_failed"/>
                  </group>
                </group>
              </page>
              <page string="Notes">
                <field name="notes"/>
              </page>
              <page string="Grades">
                <field name="grade_ids">
                  <tree>
                    <field name="course_id"/>
                    <field name="credits"/>
                    <field name="grade"/>
                    <field name="grade_type"/>
                    <field name="is_final"/>
                    <field name="state"/>
                  </tree>
                </field>
              </page>
              <page string="Courses">
                <field name="course_ids">
                  <tree>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="credits"/>
                    <field name="enrollment_count"/>
                    <field name="state"/>
                  </tree>
                </field>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
          </div>
        </form>
      </field>
    </record>

    <!-- Transcript Tree View -->
    <record id="view_lms_transcript_tree" model="ir.ui.view">
      <field name="name">lms.transcript.tree</field>
      <field name="model">lms.transcript</field>
      <field name="arch" type="xml">
        <tree decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-muted="state in ['completed', 'cancelled']">
          <field name="student_id"/>
          <field name="academic_year_id"/>
          <field name="semester_id"/>
          <field name="gpa"/>
          <field name="total_credits"/>
          <field name="total_courses"/>
          <field name="courses_completed"/>
          <field name="courses_in_progress"/>
          <field name="courses_failed"/>
          <field name="grade_count"/>
          <field name="course_count"/>
          <field name="state"/>
        </tree>
      </field>
    </record>

    <!-- Transcript Search View -->
    <record id="view_lms_transcript_search" model="ir.ui.view">
      <field name="name">lms.transcript.search</field>
      <field name="model">lms.transcript</field>
      <field name="arch" type="xml">
        <search>
          <field name="student_id"/>
          <field name="academic_year_id"/>
          <field name="semester_id"/>
          <field name="gpa"/>
          <field name="total_credits"/>
          <separator/>
          <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
          <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
          <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
          <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
          <group expand="0" string="Group By">
            <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}"/>
            <filter string="Academic Year" name="group_by_academic_year" context="{'group_by': 'academic_year_id'}"/>
            <filter string="Semester" name="group_by_semester" context="{'group_by': 'semester_id'}"/>
            <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- Transcript Action -->
    <record id="action_lms_transcript" model="ir.actions.act_window">
      <field name="name">Transcripts</field>
      <field name="res_model">lms.transcript</field>
      <field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="view_lms_transcript_search"/>
    </record>

    <!-- Transcripts Menu Item -->
    <menuitem id="menu_lms_transcripts" name="Transcripts"
              parent="lms_module.menu_root"
              action="action_lms_transcript"
              sequence="8"/>

    <!-- Note: Additional view records for Attendance, Bulk Enrollment, Course Material, Payment, Quiz, Schedule, Semester, Student, Teacher Assignment, Teacher, etc.
         should be added below in a similar manner as shown above.
         For brevity, only a subset is included here.
    -->

  </data>
</odoo>
