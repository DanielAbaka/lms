    <!-- Quiz Preview View -->
    <record id="view_lms_quiz_preview" model="ir.ui.view">
        <field name="name">lms.quiz.preview</field>
        <field name="model">lms.quiz</field>
        <field name="arch" type="xml">
            <form string="Quiz Preview">
                <header>
                    <button name="action_publish" string="Publish" type="object" class="oe_highlight" 
                            invisible="state != 'draft'"/>
                    <button name="action_start" string="Start" type="object" class="oe_highlight" 
                            invisible="state != 'published'"/>
                    <button name="action_complete" string="Complete" type="object" class="oe_highlight" 
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="state not in ('draft', 'published')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" 
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h2><field name="description"/></h2>
                    </div>
                    <notebook>
                        <page string="Questions">
                            <field name="question_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="question_type"/>
                                    <field name="points"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Settings">
                            <group>
                                <group>
                                    <field name="duration"/>
                                    <field name="passing_score"/>
                                    <field name="max_attempts"/>
                                </group>
                                <group>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="state"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Course Kanban View -->
    <record id="view_lms_course_kanban" model="ir.ui.view">
        <field name="name">lms.course.kanban</field>
        <field name="model">slide.channel</field>
        <field name="arch" type="xml">
            <kanban class="oe_background_grey" sample="1">
                <field name="image_1920" widget="image"/>
                <field name="name"/>
                <field name="code"/>
                <field name="enrollment_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_image">
                                <img t-att-src="kanban_image('slide.channel', 'image_1920', record.id.raw_value)" alt="Course Image"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="oe_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="oe_kanban_record_subtitle">
                                    <field name="code"/>
                                </div>
                                <div class="oe_kanban_record_bottom">
                                    <div class="oe_kanban_record_bottom_left">
                                        <span><field name="enrollment_count"/> students</span>
                                    </div>
                                    <div class="oe_kanban_record_bottom_right">
                                        <field name="state" widget="label_selection"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Course Views -->
    <record id="view_lms_course_form" model="ir.ui.view">
        <field name="name">lms.course.form</field>
        <field name="model">slide.channel</field>
        <field name="arch" type="xml">
            <form string="Course">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_enrollments" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="enrollment_count" widget="statinfo" string="Enrollments"/>
                        </button>
                        <button name="action_view_assignments" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="assignment_count" widget="statinfo" string="Assignments"/>
                        </button>
                    </div>
                    <notebook>
                        <page string="Course Details">
                            <group>
                                <group>
                                    <field name="name" required="1"/>
                                    <field name="code" required="1"/>
                                    <field name="credits"/>
                                    <field name="max_students"/>
                                </group>
                                <group>
                                    <field name="academic_year_id"/>
                                    <field name="semester_id"/>
                                    <field name="state"/>
                                </group>
                            </group>
                            <group string="Description">
                                <field name="description"/>
                                <field name="objectives"/>
                                <field name="prerequisites"/>
                            </group>
                        </page>
                        <page string="Enrollments">
                            <field name="enrollment_ids">
                                <tree>
                                    <field name="student_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Teacher Assignments">
                            <field name="teacher_assignment_ids">
                                <tree>
                                    <field name="teacher_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_lms_course_tree" model="ir.ui.view">
        <field name="name">lms.course.tree</field>
        <field name="model">slide.channel</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'published'">
                <field name="name"/>
                <field name="code"/>
                <field name="academic_year_id"/>
                <field name="semester_id"/>
                <field name="credits"/>
                <field name="max_students"/>
                <field name="enrollment_count"/>
                <field name="assignment_count"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_lms_course_search" model="ir.ui.view">
        <field name="name">lms.course.search</field>
        <field name="model">slide.channel</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="academic_year_id"/>
                <field name="semester_id"/>
                <field name="credits"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Published" name="published" domain="[('state', '=', 'published')]"/>
                <group expand="0" string="Group By">
                    <filter string="Academic Year" name="group_by_academic_year" context="{'group_by': 'academic_year_id'}"/>
                    <filter string="Semester" name="group_by_semester" context="{'group_by': 'semester_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Course Actions -->
    <record id="action_lms_courses" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">slide.channel</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_lms_course_search"/>
    </record>

    <record id="action_lms_courses_kanban" model="ir.actions.act_window">
        <field name="name">Course Overview</field>
        <field name="res_model">slide.channel</field>
        <field name="view_mode">kanban</field>
        <field name="search_view_id" ref="view_lms_course_search"/>
    </record>

  </data>
</odoo>