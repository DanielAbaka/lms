    <!-- Teacher Portal Dashboard View -->
    <record id="view_lms_teacher_dashboard" model="ir.ui.view">
        <field name="name">lms.teacher.dashboard</field>
        <field name="model">lms.teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher Dashboard">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="assigned_course_count" widget="statinfo" string="Assigned Courses"/>
                        <field name="student_count" widget="statinfo" string="Total Students"/>
                        <field name="attendance_rate" widget="statinfo" string="Average Attendance"/>
                        <field name="grade_count" widget="statinfo" string="Pending Grades"/>
                    </div>
                    <notebook>
                        <page string="My Courses">
                            <field name="course_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="student_count"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Course Materials">
                            <field name="document_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="course_id"/>
                                    <field name="type"/>
                                    <field name="create_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Pending Grades">
                            <field name="grade_ids">
                                <tree>
                                    <field name="student_id"/>
                                    <field name="course_id"/>
                                    <field name="grade"/>
                                    <field name="status"/>
                                    <field name="create_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Attendance Records">
                            <field name="attendance_ids">
                                <tree>
                                    <field name="student_id"/>
                                    <field name="course_id"/>
                                    <field name="date"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Quiz Preview View -->
    <record id="view_lms_quiz_preview" model="ir.ui.view">
        <field name="name">lms.quiz.preview</field>
        <field name="model">lms.quiz</field>
        <field name="arch" type="xml">
            <form string="Quiz Preview">
                <header>
                    <button name="action_start_quiz" string="Start Quiz" type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h2><field name="description"/></h2>
                    </div>
                    <notebook>
                        <page string="Questions">
                            <field name="question_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="question_type"/>
                                    <field name="points"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Settings">
                            <group>
                                <group>
                                    <field name="duration"/>
                                    <field name="passing_score"/>
                                    <field name="max_attempts"/>
                                </group>
                                <group>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="state"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Course Kanban View -->
    <record id="view_lms_course_kanban" model="ir.ui.view">
        <field name="name">lms.course.kanban</field>
        <field name="model">lms.course</field>
        <field name="arch" type="xml">
            <kanban class="oe_background_grey" sample="1">
                <field name="image_1920" widget="image"/>
                <field name="name"/>
                <field name="code"/>
                <field name="teacher_id"/>
                <field name="student_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_image">
                                <img t-att-src="kanban_image('lms.course', 'image_1920', record.id.raw_value)" alt="Course Image"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="oe_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="oe_kanban_record_subtitle">
                                    <field name="code"/>
                                </div>
                                <div class="oe_kanban_record_bottom">
                                    <div class="oe_kanban_record_bottom_left">
                                        <field name="teacher_id"/>
                                    </div>
                                    <div class="oe_kanban_record_bottom_right">
                                        <field name="student_count"/> students
                                    </div>
                                </div>
                                <div class="oe_kanban_record_bottom">
                                    <field name="state" widget="label_selection"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Course Views -->
    <record id="view_lms_course_form" model="ir.ui.view">
        <field name="name">lms.course.form</field>
        <field name="model">lms.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="student_count" widget="statinfo" string="Students"/>
                        <field name="material_count" widget="statinfo" string="Materials"/>
                    </div>
                    <notebook>
                        <page string="Course Details">
                            <group>
                                <group>
                                    <field name="name" required="1"/>
                                    <field name="code" required="1"/>
                                    <field name="teacher_id" required="1"/>
                                    <field name="duration"/>
                                </group>
                                <group>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="schedule"/>
                                    <field name="state"/>
                                </group>
                            </group>
                            <group string="Description">
                                <field name="description"/>
                            </group>
                        </page>
                        <page string="Students">
                            <field name="student_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="enrollment_date"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Materials">
                            <field name="document_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="create_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_lms_course_tree" model="ir.ui.view">
        <field name="name">lms.course.tree</field>
        <field name="model">lms.course</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'active'">
                <field name="name"/>
                <field name="code"/>
                <field name="teacher_id"/>
                <field name="student_count"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_lms_course_search" model="ir.ui.view">
        <field name="name">lms.course.search</field>
        <field name="model">lms.course</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="teacher_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Archived" name="archived" domain="[('state', '=', 'archived')]"/>
                <group expand="0" string="Group By">
                    <filter string="Teacher" name="group_by_teacher" context="{'group_by': 'teacher_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Course Actions -->
    <record id="action_lms_courses" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">lms.course</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_lms_course_search"/>
    </record>

    <record id="action_lms_courses_kanban" model="ir.actions.act_window">
        <field name="name">Course Overview</field>
        <field name="res_model">lms.course</field>
        <field name="view_mode">kanban</field>
        <field name="search_view_id" ref="view_lms_course_search"/>
    </record>

  </data>
</odoo>