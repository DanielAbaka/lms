<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Define the Student Action -->
    <record id="action_lms_students" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('is_student', '=', True)]</field>
        <field name="context">{'default_is_student': True}</field>
        <field name="search_view_id" ref="lms_module.view_lms_student_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first student!
            </p>
            <p>
                Create student profiles to manage academic information and course enrollments.
            </p>
        </field>
    </record>

    <!-- LMS Dashboard Action -->
    <record id="action_lms_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">lms.dashboard</field>
        <field name="view_mode">kanban</field>
        <field name="help" type="html">
            <div class="o_view_nocontent_smiling_face">
                <h1>Welcome to your LMS Dashboard!</h1>
                <p>This dashboard provides an overview of your learning management system.</p>
            </div>
        </field>
    </record>

    <!-- Root Menu -->
    <menuitem id="menu_root" name="LMS" web_icon="lms_module,static/description/icon.png" sequence="10"/>

    <!-- Dashboard Menu -->
    <menuitem id="menu_lms_dashboard" name="Dashboard"
              parent="menu_root"
              action="action_lms_dashboard"
              sequence="1"/>

    <!-- Academic Menu -->
    <menuitem id="menu_lms_academic" name="Academic"
              parent="menu_root" sequence="2"/>

    <!-- Courses Menu -->
    <menuitem id="menu_lms_courses" name="Courses"
              parent="menu_lms_academic"
              action="action_lms_courses"
              sequence="1"/>

    <!-- Students Menu -->
    <menuitem id="menu_lms_students" name="Students"
              parent="menu_lms_academic"
              action="action_lms_students"
              sequence="2"/>

    <!-- Teachers Menu -->
    <menuitem id="menu_lms_teachers" name="Teachers"
              parent="menu_lms_academic"
              action="action_lms_teachers"
              sequence="3"/>

    <!-- Administration Menu -->
    <menuitem id="menu_lms_administration" name="Administration"
              parent="menu_root"
              sequence="15"/>

    <!-- Quiz Action and Menu -->
    <record id="action_lms_quiz" model="ir.actions.act_window">
        <field name="name">Quizzes</field>
        <field name="res_model">survey.survey</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <div class="o_view_nocontent_smiling_face">
                <h1>Create your first quiz!</h1>
                <p>Create quizzes and assessments for your courses.</p>
            </div>
        </field>
    </record>

    <menuitem id="menu_lms_quiz" name="Quizzes"
              parent="menu_lms_academic"
              action="action_lms_quiz"
              sequence="10"/>

</odoo>
