<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Root Menu -->
        <menuitem id="menu_lms_root" 
                  name="Learning Management" 
                  web_icon="lms_module,static/description/icon.png"
                  sequence="10"/>

        <!-- Dashboard Menu -->
        <record id="action_lms_dashboard" model="ir.actions.act_window">
            <field name="name">Dashboard</field>
            <field name="res_model">res.users</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
        </record>

        <menuitem id="menu_lms_dashboard" 
                  name="Dashboard" 
                  parent="menu_lms_root"
                  action="action_lms_dashboard"
                  web_icon="lms_module,static/description/icon.png"
                  sequence="1"/>

        <!-- Academic Management Menu -->
        <menuitem id="menu_lms_academic" 
                  name="Academic" 
                  parent="menu_lms_root"
                  web_icon="lms_module,static/description/icon.png"
                  sequence="2"/>

        <!-- Academic Year Views -->
        <record id="view_lms_academic_year_form" model="ir.ui.view">
            <field name="name">lms.academic.year.form</field>
            <field name="model">lms.academic.year</field>
            <field name="arch" type="xml">
                <form string="Academic Year">
                    <header>
                        <button name="action_activate" string="Activate" type="object" class="oe_highlight" states="draft"/>
                        <button name="action_complete" string="Complete" type="object" class="oe_highlight" states="active"/>
                        <button name="action_cancel" string="Cancel" type="object" states="draft,active"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object" states="cancelled"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_semesters" type="object" class="oe_stat_button" icon="fa-calendar">
                                <field name="semester_count" widget="statinfo" string="Semesters"/>
                            </button>
                            <button name="action_view_students" type="object" class="oe_stat_button" icon="fa-users">
                                <field name="student_count" widget="statinfo" string="Students"/>
                            </button>
                            <button name="action_view_teachers" type="object" class="oe_stat_button" icon="fa-chalkboard-teacher">
                                <field name="teacher_count" widget="statinfo" string="Teachers"/>
                            </button>
                        </div>
                        <notebook>
                            <page string="General Information">
                                <group>
                                    <group>
                                        <field name="name" required="1"/>
                                        <field name="code" required="1"/>
                                        <field name="start_date" required="1"/>
                                        <field name="end_date" required="1"/>
                                        <field name="state"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Semesters">
                                <field name="semester_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Enrollments">
                                <field name="enrollment_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="course_id"/>
                                        <field name="enrollment_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Courses">
                                <field name="course_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="credits"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Teacher Assignments">
                                <field name="teacher_assignment_ids">
                                    <tree>
                                        <field name="teacher_id"/>
                                        <field name="course_id"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Grades">
                                <field name="grade_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="course_id"/>
                                        <field name="grade"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Documents">
                                <field name="document_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_lms_academic_year_tree" model="ir.ui.view">
            <field name="name">lms.academic.year.tree</field>
            <field name="model">lms.academic.year</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-muted="state in ['completed', 'cancelled']">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="semester_count"/>
                    <field name="student_count"/>
                    <field name="teacher_count"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_lms_academic_year_search" model="ir.ui.view">
            <field name="name">lms.academic.year.search</field>
            <field name="model">lms.academic.year</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                    <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_lms_academic_year" model="ir.actions.act_window">
            <field name="name">Academic Years</field>
            <field name="res_model">lms.academic.year</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_academic_year_search"/>
        </record>

        <menuitem id="menu_lms_academic_year" 
                  name="Academic Years" 
                  parent="menu_lms_academic"
                  action="action_lms_academic_year"
                  sequence="1"/>

        <!-- Semester Views -->
        <record id="view_lms_semester_form" model="ir.ui.view">
            <field name="name">lms.semester.form</field>
            <field name="model">lms.semester</field>
            <field name="arch" type="xml">
                <form string="Semester">
                    <header>
                        <button name="action_activate" string="Activate" type="object" class="oe_highlight" states="draft"/>
                        <button name="action_complete" string="Complete" type="object" class="oe_highlight" states="active"/>
                        <button name="action_cancel" string="Cancel" type="object" states="draft,active"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object" states="cancelled"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_courses" type="object" class="oe_stat_button" icon="fa-book">
                                <field name="course_count" widget="statinfo" string="Courses"/>
                            </button>
                            <button name="action_view_enrollments" type="object" class="oe_stat_button" icon="fa-users">
                                <field name="enrollment_count" widget="statinfo" string="Enrollments"/>
                            </button>
                            <button name="action_view_teachers" type="object" class="oe_stat_button" icon="fa-chalkboard-teacher">
                                <field name="teacher_count" widget="statinfo" string="Teachers"/>
                            </button>
                        </div>
                        <notebook>
                            <page string="General Information">
                                <group>
                                    <group>
                                        <field name="name" required="1"/>
                                        <field name="code" required="1"/>
                                        <field name="academic_year_id" required="1"/>
                                        <field name="sequence" required="1"/>
                                        <field name="start_date" required="1"/>
                                        <field name="end_date" required="1"/>
                                        <field name="state"/>
                                    </group>
                                    <group>
                                        <field name="enrollment_start"/>
                                        <field name="enrollment_end"/>
                                        <field name="add_drop_start"/>
                                        <field name="add_drop_end"/>
                                        <field name="active"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Courses">
                                <field name="course_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="credits"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Enrollments">
                                <field name="enrollment_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="course_id"/>
                                        <field name="enrollment_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Teacher Assignments">
                                <field name="teacher_assignment_ids">
                                    <tree>
                                        <field name="teacher_id"/>
                                        <field name="course_id"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Grades">
                                <field name="grade_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="course_id"/>
                                        <field name="grade"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Documents">
                                <field name="document_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_lms_semester_tree" model="ir.ui.view">
            <field name="name">lms.semester.tree</field>
            <field name="model">lms.semester</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-muted="state in ['completed', 'cancelled']">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="academic_year_id"/>
                    <field name="sequence"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="course_count"/>
                    <field name="enrollment_count"/>
                    <field name="teacher_count"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_lms_semester_search" model="ir.ui.view">
            <field name="name">lms.semester.search</field>
            <field name="model">lms.semester</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="academic_year_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                    <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Academic Year" name="group_by_academic_year" context="{'group_by': 'academic_year_id'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_lms_semester" model="ir.actions.act_window">
            <field name="name">Semesters</field>
            <field name="res_model">lms.semester</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_semester_search"/>
        </record>

        <menuitem id="menu_lms_semester" 
                  name="Semesters" 
                  parent="menu_lms_academic"
                  action="action_lms_semester"
                  sequence="2"/>

        <!-- Course Views -->
        <record id="view_lms_course_form" model="ir.ui.view">
            <field name="name">lms.course.form</field>
            <field name="model">slide.channel</field>
            <field name="arch" type="xml">
                <form string="Course">
                    <header>
                        <button name="action_publish" string="Publish" type="object" class="oe_highlight" states="draft"/>
                        <button name="action_unpublish" string="Unpublish" type="object" states="published"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_enrollments" type="object" class="oe_stat_button" icon="fa-users">
                                <field name="enrollment_count" widget="statinfo" string="Enrollments"/>
                            </button>
                            <button name="action_view_assignments" type="object" class="oe_stat_button" icon="fa-chalkboard-teacher">
                                <field name="assignment_count" widget="statinfo" string="Assignments"/>
                            </button>
                        </div>
                        <notebook>
                            <page string="General Information">
                                <group>
                                    <group>
                                        <field name="name" required="1"/>
                                        <field name="code" required="1"/>
                                        <field name="academic_year_id"/>
                                        <field name="semester_id"/>
                                        <field name="credits"/>
                                        <field name="max_students"/>
                                        <field name="state"/>
                                    </group>
                                    <group>
                                        <field name="objectives"/>
                                        <field name="prerequisites"/>
                                        <field name="active"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Enrollments">
                                <field name="enrollment_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="enrollment_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Teacher Assignments">
                                <field name="teacher_assignment_ids">
                                    <tree>
                                        <field name="teacher_id"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Grades">
                                <field name="grade_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="grade"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_lms_course_tree" model="ir.ui.view">
            <field name="name">lms.course.tree</field>
            <field name="model">slide.channel</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state == 'published'">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="academic_year_id"/>
                    <field name="semester_id"/>
                    <field name="credits"/>
                    <field name="max_students"/>
                    <field name="enrollment_count"/>
                    <field name="assignment_count"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_lms_course_search" model="ir.ui.view">
            <field name="name">lms.course.search</field>
            <field name="model">slide.channel</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="academic_year_id"/>
                    <field name="semester_id"/>
                    <field name="credits"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Published" name="published" domain="[('state', '=', 'published')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Academic Year" name="group_by_academic_year" context="{'group_by': 'academic_year_id'}"/>
                        <filter string="Semester" name="group_by_semester" context="{'group_by': 'semester_id'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_lms_course" model="ir.actions.act_window">
            <field name="name">Courses</field>
            <field name="res_model">slide.channel</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_course_search"/>
        </record>

        <menuitem id="menu_lms_course" 
                  name="Courses" 
                  parent="menu_lms_academic"
                  action="action_lms_course"
                  sequence="3"/>

        <!-- Student Management Menu -->
        <menuitem id="menu_lms_student" 
                  name="Student Management" 
                  parent="menu_lms_root"
                  web_icon="lms_module,static/description/icon.png"
                  sequence="3"/>

        <!-- Student Management Sub-menus -->
        <menuitem id="menu_lms_enrollment" 
                  name="Enrollments" 
                  parent="menu_lms_student"
                  action="action_lms_enrollment"
                  sequence="1"/>

        <menuitem id="menu_lms_course_planning" 
                  name="Course Planning" 
                  parent="menu_lms_student"
                  action="action_lms_course_planning"
                  sequence="2"/>

        <menuitem id="menu_lms_student_portal" 
                  name="Student Portals" 
                  parent="menu_lms_student"
                  action="action_lms_student_portal"
                  sequence="3"/>

        <!-- Teaching Management Menu -->
        <menuitem id="menu_lms_teaching" 
                  name="Teaching" 
                  parent="menu_lms_root"
                  web_icon="lms_module,static/description/icon.png"
                  sequence="4"/>

        <!-- Teaching Management Sub-menus -->
        <menuitem id="menu_lms_teacher_assignment" 
                  name="Teacher Assignments" 
                  parent="menu_lms_teaching"
                  action="action_lms_teacher_assignment"
                  sequence="1"/>

        <menuitem id="menu_lms_quiz" 
                  name="Quizzes" 
                  parent="menu_lms_teaching"
                  action="action_lms_quiz"
                  sequence="2"/>

        <menuitem id="menu_lms_document" 
                  name="Course Materials" 
                  parent="menu_lms_teaching"
                  action="action_lms_document"
                  sequence="3"/>

        <!-- Assessment Menu -->
        <menuitem id="menu_lms_assessment" 
                  name="Assessment" 
                  parent="menu_lms_root"
                  web_icon="lms_module,static/description/icon.png"
