        <!-- Quiz Question Views -->
        <record id="view_lms_quiz_question_form" model="ir.ui.view">
            <field name="name">lms.quiz.question.form</field>
            <field name="model">lms.quiz.question</field>
            <field name="arch" type="xml">
                <form string="Quiz Question">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="quiz_id" required="1"/>
                                <field name="question_type" required="1"/>
                                <field name="points" required="1"/>
                                <field name="state"/>
                            </group>
                            <group>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Question Content">
                                <field name="question_text"/>
                                <field name="option_ids">
                                    <tree>
                                        <field name="text"/>
                                        <field name="is_correct"/>
                                        <field name="sequence"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_lms_quiz_question_tree" model="ir.ui.view">
            <field name="name">lms.quiz.question.tree</field>
            <field name="model">lms.quiz.question</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-muted="state == 'archived'">
                    <field name="name"/>
                    <field name="quiz_id"/>
                    <field name="question_type"/>
                    <field name="points"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_lms_quiz_question_search" model="ir.ui.view">
            <field name="name">lms.quiz.question.search</field>
            <field name="model">lms.quiz.question</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="quiz_id"/>
                    <field name="question_type"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                    <filter string="Archived" name="archived" domain="[('state', '=', 'archived')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Quiz" name="group_by_quiz" context="{'group_by': 'code'}"/>
                        <filter string="Question Type" name="group_by_type" context="{'group_by': 'question_type'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_lms_quiz_question" model="ir.actions.act_window">
            <field name="name">Quiz Questions</field>
            <field name="res_model">lms.quiz.question</field>
            <field name="view_mode">tree,form</field>
