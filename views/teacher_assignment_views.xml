<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- ================================================= -->
        <!-- 1) TREE VIEW: lms.teacher.assignment             -->
        <!-- ================================================= -->
        <record id="view_lms_teacher_assignment_tree" model="ir.ui.view">
            <field name="name">lms.teacher.assignment.tree</field>
            <field name="model">lms.teacher.assignment</field>
            <field name="arch" type="xml">
                <!-- 
                  You can decorate rows based on state:
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'in_progress'"
                  decoration-muted="state in ['completed','cancelled']"
                -->
                <tree decoration-info="state == 'draft'"
                      decoration-success="state == 'in_progress'"
                      decoration-muted="state in ['completed','cancelled']">
                    <field name="name"/>
                    <field name="teacher_id"/>
                    <field name="course_id"/>
                    <field name="academic_year_id"/>
                    <field name="semester_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- ================================================= -->
        <!-- 2) FORM VIEW: lms.teacher.assignment             -->
        <!-- ================================================= -->
        <record id="view_lms_teacher_assignment_form" model="ir.ui.view">
            <field name="name">lms.teacher.assignment.form</field>
            <field name="model">lms.teacher.assignment</field>
            <field name="arch" type="xml">
                <form string="Teacher Assignment">
                    <header>
                        <!-- Buttons for state transitions -->
                        <button name="action_assign" string="Assign" type="object" 
                                class="oe_highlight"
                                attrs="{'invisible':[('state','!=','draft')]}"/>
                        <button name="action_start" string="Start" type="object"
                                attrs="{'invisible':[('state','!=','assigned')]}"/>
                        <button name="action_complete" string="Complete" type="object"
                                attrs="{'invisible':[('state','!=','in_progress')]}"/>
                        <button name="action_cancel" string="Cancel" type="object"
                                attrs="{'invisible':[('state','not in',['draft','assigned','in_progress'])]}"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                                attrs="{'invisible':[('state','!=','cancelled')]}" />

                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,assigned,in_progress,completed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Assignment Reference" readonly="1"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="teacher_id" required="1" 
                                       domain="[('is_teacher','=',True)]"/>
                                <field name="admin_id" domain="[('is_admin','=',True)]"/>
                                <field name="course_id" required="1"/>
                                <field name="academic_year_id" required="1"/>
                                <field name="semester_id" required="1"/>
                            </group>
                            <group>
                                <field name="start_date" required="1"/>
                                <field name="end_date" required="1"/>
                                <field name="classroom"/>
                                <field name="max_students"/>
                                <field name="schedule_template_id"/>
                            </group>
                        </group>

                        <group string="Status & Info">
                            <group>
                                <field name="schedule" widget="text"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="student_count" readonly="1"/>
                                <field name="quiz_count" readonly="1"/>
                                <field name="document_count" readonly="1"/>
                                <field name="attendance_rate" readonly="1"/>
                                <field name="average_grade" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Enrollments">
                                <field name="enrollment_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="course_id"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Attendance">
                                <field name="attendance_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="date"/>
                                        <field name="status"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Grades">
                                <field name="grade_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="grade"/>
                                        <field name="grade_type"/>
                                        <field name="date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Quizzes">
                                <!-- Button that calls action_view_quizzes -->
                                <button name="action_view_quizzes" type="object" class="oe_stat_button" icon="fa-question-circle">
                                    <field name="quiz_count" widget="statinfo" string="Quizzes"/>
                                </button>
                                <field name="quiz_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Documents">
                                <!-- Button that calls action_view_documents -->
                                <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file">
                                    <field name="document_count" widget="statinfo" string="Documents"/>
                                </button>
                                <field name="document_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="date"/>
                                        <field name="file_type"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Schedules">
                                <field name="schedule_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="date"/>
                                        <field name="day_of_week"/>
                                        <field name="start_time"/>
                                        <field name="end_time"/>
                                        <field name="classroom"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Students">
                                <button name="action_view_students" type="object" class="oe_stat_button" icon="fa-users">
                                    <field name="student_count" widget="statinfo" string="Students"/>
                                </button>
                                <!-- student_ids is Many2many computed from enrollments -->
                                <field name="student_ids" mode="tree" readonly="1">
                                    <tree>
                                        <field name="name"/>
                                        <field name="student_id"/>
                                        <field name="phone"/>
                                        <field name="major"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>

                    <!-- Chatter if needed -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ================================================= -->
        <!-- 3) SEARCH VIEW: lms.teacher.assignment           -->
        <!-- ================================================= -->
        <record id="view_lms_teacher_assignment_search" model="ir.ui.view">
            <field name="name">lms.teacher.assignment.search</field>
            <field name="model">lms.teacher.assignment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="teacher_id"/>
                    <field name="course_id"/>
                    <field name="academic_year_id"/>
                    <field name="semester_id"/>
                    <field name="classroom"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Assigned" name="assigned" domain="[('state','=','assigned')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('state','=','in_progress')]"/>
                    <filter string="Completed" name="completed" domain="[('state','=','completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Teacher" name="group_by_teacher" context="{'group_by':'teacher_id'}"/>
                        <filter string="Course" name="group_by_course" context="{'group_by':'course_id'}"/>
                        <filter string="Academic Year" name="group_by_academic_year" context="{'group_by':'academic_year_id'}"/>
                        <filter string="Semester" name="group_by_semester" context="{'group_by':'semester_id'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ================================================= -->
        <!-- 4) ACTION: lms.teacher.assignment                -->
        <!-- ================================================= -->
        <record id="action_lms_teacher_assignment" model="ir.actions.act_window">
            <field name="name">Teacher Assignments</field>
            <field name="res_model">lms.teacher.assignment</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_teacher_assignment_search"/>
        </record>

        <!--
          Add a menu item referencing "action_lms_teacher_assignment" in your menu file, e.g.:
          <menuitem id="menu_lms_teacher_assignments"
                    name="Teacher Assignments"
                    parent="lms_module.menu_root"
                    action="action_lms_teacher_assignment"
                    sequence="20"/>
        -->

    </data>
</odoo>
