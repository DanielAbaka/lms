<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Teacher Assignment Form View -->
        <record id="view_lms_teacher_assignment_form" model="ir.ui.view">
            <field name="name">lms.teacher.assignment.form</field>
            <field name="model">lms.teacher.assignment</field>
            <field name="arch" type="xml">
                <form string="Teacher Assignment">
                    <header>
                        <button name="action_assign" string="Assign" type="object" class="oe_highlight" states="draft"/>
                        <button name="action_start" string="Start" type="object" class="oe_highlight" states="assigned"/>
                        <button name="action_complete" string="Complete" type="object" class="oe_highlight" states="in_progress"/>
                        <button name="action_cancel" string="Cancel" type="object" states="draft,assigned,in_progress"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object" states="cancelled"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_quizzes" type="object" class="oe_stat_button" icon="fa-question-circle">
                                <field name="quiz_count" widget="statinfo" string="Quizzes"/>
                            </button>
                            <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file">
                                <field name="document_count" widget="statinfo" string="Documents"/>
                            </button>
                            <button name="action_view_students" type="object" class="oe_stat_button" icon="fa-users">
                                <field name="student_count" widget="statinfo" string="Students"/>
                            </button>
                        </div>
                        <notebook>
                            <page string="General Information">
                                <group>
                                    <group>
                                        <field name="teacher_id" required="1"/>
                                        <field name="course_id" required="1"/>
                                        <field name="start_date" required="1"/>
                                        <field name="end_date" required="1"/>
                                        <field name="state"/>
                                    </group>
                                    <group>
                                        <field name="max_students"/>
                                        <field name="active"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Quizzes">
                                <field name="quiz_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Documents">
                                <field name="document_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="date"/>
                                        <field name="is_public"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Students">
                                <field name="student_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="enrollment_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Grades">
                                <field name="grade_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="grade"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Teacher Assignment Tree View -->
        <record id="view_lms_teacher_assignment_tree" model="ir.ui.view">
            <field name="name">lms.teacher.assignment.tree</field>
            <field name="model">lms.teacher.assignment</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state == 'in_progress'" decoration-muted="state in ['completed', 'cancelled']">
                    <field name="teacher_id"/>
                    <field name="course_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="schedule"/>
                    <field name="classroom"/>
                    <field name="max_students"/>
                    <field name="quiz_count"/>
                    <field name="document_count"/>
                    <field name="student_count"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Teacher Assignment Search View -->
        <record id="view_lms_teacher_assignment_search" model="ir.ui.view">
            <field name="name">lms.teacher.assignment.search</field>
            <field name="model">lms.teacher.assignment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="teacher_id"/>
                    <field name="course_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="schedule"/>
                    <field name="classroom"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Assigned" name="assigned" domain="[('state', '=', 'assigned')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Teacher" name="group_by_teacher" context="{'group_by': 'teacher_id'}"/>
                        <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Teacher Assignment Action -->
        <record id="action_lms_teacher_assignment" model="ir.actions.act_window">
            <field name="name">Teacher Assignments</field>
            <field name="res_model">lms.teacher.assignment</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_teacher_assignment_search"/>
        </record>

        <!-- Teacher Assignments Menu Item -->
        <menuitem id="menu_lms_teacher_assignments" name="Teacher Assignments"
                  parent="lms_module.menu_root"
                  action="action_lms_teacher_assignment" 
                  sequence="4"/>
    </data>
</odoo>