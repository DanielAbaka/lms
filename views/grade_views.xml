<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Grade Form View -->
        <record id="view_lms_grade_form" model="ir.ui.view">
            <field name="name">lms.grade.form</field>
            <field name="model">lms.grade</field>
            <field name="arch" type="xml">
                <form string="Grade">
                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <field name="transcript_count" widget="statinfo" string="Transcripts"/>
                        </div>
                        <notebook>
                            <page string="General Information">
                                <group>
                                    <group>
                                        <field name="student_id" required="1"/>
                                        <field name="enrollment_id" required="1"/>
                                        <field name="course_id" required="1"/>
                                        <field name="grade_letter" required="1"/>
                                        <field name="grade_point" required="1"/>
                                        <field name="credits" required="1"/>
                                        <field name="state"/>
                                    </group>
                                    <group>
                                        <field name="date"/>
                                        <field name="active"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Grade Details">
                                <group>
                                    <group>
                                        <field name="grade_letter"/>
                                        <field name="grade_point"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Comments">
                                <field name="comments"/>
                            </page>
                            <page string="Transcripts">
                                <field name="transcript_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="academic_year_id"/>
                                        <field name="semester_id"/>
                                        <field name="gpa"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Grade Tree View -->
        <record id="view_lms_grade_tree" model="ir.ui.view">
            <field name="name">lms.grade.tree</field>
            <field name="model">lms.grade</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-muted="state == 'rejected'">
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="grade_letter"/>
                    <field name="grade_point"/>
                    <field name="credits"/>
                    <field name="date"/>
                    <field name="transcript_count"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Grade Search View -->
        <record id="view_lms_grade_search" model="ir.ui.view">
            <field name="name">lms.grade.search</field>
            <field name="model">lms.grade</field>
            <field name="arch" type="xml">
                <search>
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="grade_letter"/>
                    <field name="date"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                    <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                    <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}"/>
                        <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Grade Action -->
        <record id="action_lms_grade" model="ir.actions.act_window">
            <field name="name">Grades</field>
            <field name="res_model">lms.grade</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_grade_search"/>
        </record>

        <!-- Grades Menu Item -->
        <menuitem id="menu_lms_grades" name="Grades"
                  parent="lms_module.menu_root"
                  action="action_lms_grade" 
                  sequence="5"/>
    </data>
</odoo>