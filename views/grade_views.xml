<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================= -->
        <!-- 1) TREE VIEW: lms.grade -->
        <!-- ========================= -->
        <record id="view_lms_grade_tree" model="ir.ui.view">
            <field name="name">lms.grade.tree</field>
            <field name="model">lms.grade</field>
            <field name="arch" type="xml">
                <!-- 
                  Possible highlight: 
                  decoration-info="state=='draft'"
                  decoration-success="state=='submitted'"
                  decoration-muted="state=='confirmed'"
                -->
                <tree decoration-info="state == 'draft'"
                      decoration-success="state == 'submitted'"
                      decoration-muted="state == 'confirmed'">
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="grade"/>
                    <field name="credits"/>
                    <field name="grade_type"/>
                    <field name="date"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- ========================= -->
        <!-- 2) FORM VIEW: lms.grade -->
        <!-- ========================= -->
        <record id="view_lms_grade_form" model="ir.ui.view">
            <field name="name">lms.grade.form</field>
            <field name="model">lms.grade</field>
            <field name="arch" type="xml">
                <form string="Student Grade" create="1" edit="1">
                    <header>
                        <!-- Buttons to submit or reset grade, referencing your methods -->
                        <button name="action_submit_grade" string="Submit" type="object" class="oe_highlight"
                                invisible="state != 'draft'" />
                        <button name="action_reset_grade" string="Reset" type="object" 
                                invisible="state != 'submitted'" />
                        <!-- Or possibly a confirm state if you want 'confirmed' after 'submitted' -->

                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,submitted,confirmed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Grade Reference" readonly="1"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="student_id" required="1" domain="[('is_student','=',True)]"/>
                                <field name="course_id" required="1"/>
                                <field name="grade_type" required="1"/>
                                <field name="is_final"/>
                                <field name="credits" required="1"/>
                            </group>
                            <group>
                                <field name="enrollment_id" required="1"/>
                                <field name="quiz_id"/>
                                <field name="teacher_assignment_id"/>
                                <field name="date"/>
                                <field name="state" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="grade" required="1"/>
                            </group>
                            <group>
                                <field name="remarks" nolabel="1"/>
                            </group>
                        </group>

                        <group string="Grading Info" colspan="2">
                            <field name="graded_by" readonly="1"/>
                            <field name="grading_date" readonly="1"/>
                        </group>

                    </sheet>

                    <!-- Chatter if needed (mail.thread, mail.activity.mixin) -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ========================= -->
        <!-- 3) SEARCH VIEW: lms.grade -->
        <!-- ========================= -->
        <record id="view_lms_grade_search" model="ir.ui.view">
            <field name="name">lms.grade.search</field>
            <field name="model">lms.grade</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="grade_type"/>
                    <field name="date"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                    <filter string="Confirmed" name="confirmed" domain="[('state','=','confirmed')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}"/>
                        <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}"/>
                        <filter string="Grade Type" name="group_by_gradetype" context="{'group_by': 'grade_type'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ========================= -->
        <!-- 4) ACTION: lms.grade     -->
        <!-- ========================= -->
        <record id="action_lms_grade" model="ir.actions.act_window">
            <field name="name">Grades</field>
            <field name="res_model">lms.grade</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_grade_search"/>
        </record>

        <!-- 
          If your menu is in another file, you can link it:
          <menuitem id="menu_lms_grade"
                    name="Grades"
                    parent="lms_module.menu_root"
                    action="action_lms_grade"
                    sequence="10"/>
        -->

    </data>
</odoo>
