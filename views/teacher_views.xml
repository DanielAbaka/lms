<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ✅ Teacher Form View -->
        <record id="view_lms_teacher_form" model="ir.ui.view">
            <field name="name">lms.teacher.form</field>
            <field name="model">res.users</field>
            <field name="arch" type="xml">
                <form string="Teacher Profile" class="lms_module o_form_view">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" required="1" placeholder="Teacher Name"/></h1>
                        </div>
                        <field name="image_1920" widget="image" class="oe_avatar"/>
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <group>
                                    <field name="email" widget="email"/>
                                    <field name="phone" widget="phone"/>
                                </group>
                            </div>
                            <div class="col-md-6">
                                <group>
                                    <field name="is_teacher" invisible="1"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                            </div>
                        </div>
                        <notebook>
                            <page string="Courses" name="assigned_courses">
                                <field name="assigned_courses" widget="many2many_tags"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ✅ Teacher Tree View -->
        <record id="view_lms_teacher_tree" model="ir.ui.view">
            <field name="name">lms.teacher.tree</field>
            <field name="model">res.users</field>
            <field name="arch" type="xml">
                <tree class="lms_module o_list_view">
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>

        <!-- ✅ Teacher Search View -->
        <record id="view_lms_teacher_search" model="ir.ui.view">
            <field name="name">lms.teacher.search</field>
            <field name="model">res.users</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <filter name="filter_teachers" string="Teachers" domain="[('is_teacher', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ✅ Teacher Kanban View -->
        <record id="view_lms_teacher_kanban" model="ir.ui.view">
            <field name="name">lms.teacher.kanban</field>
            <field name="model">res.users</field>
            <field name="arch" type="xml">
                <kanban class="lms_module o_kanban_view">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="image_128"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                                <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image:url('#{kanban_image('res.users', 'image_128', record.id.raw_value)}')"/>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div>
                                        <field name="email" widget="email"/>
                                    </div>
                                    <div>
                                        <field name="phone" widget="phone"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ✅ Teacher Action Window -->
        <record id="action_lms_teachers" model="ir.actions.act_window">
            <field name="name">Teachers</field>
            <field name="res_model">res.users</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">[('is_teacher', '=', True)]</field>
            <field name="context">{'default_is_teacher': True}</field>
            <field name="search_view_id" ref="view_lms_teacher_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add your first teacher!
                </p>
                <p>
                    Create teacher profiles to manage faculty information and course assignments.
                </p>
            </field>
        </record>

        <!-- ✅ Teacher Menu Item -->
        <menuitem id="menu_lms_teachers"
                  name="Teachers"
                  action="action_lms_teachers"
                  parent="lms_module.menu_root"
                  sequence="5"/>
    </data>
</odoo>