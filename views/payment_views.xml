<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
          ===================================================================
          1) lms.payment views & action
          ===================================================================
        -->

        <!-- Tree View: lms.payment -->
        <record id="view_lms_payment_tree" model="ir.ui.view">
            <field name="name">lms.payment.tree</field>
            <field name="model">lms.payment</field>
            <field name="arch" type="xml">
                <!-- Possible row highlights, e.g. decoration-info="state=='pending'" -->
                <tree decoration-info="state == 'pending'"
                      decoration-success="state == 'completed'"
                      decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="enrollment_id"/>
                    <field name="course_id"/>
                    <field name="date"/>
                    <field name="amount"/>
                    <field name="payment_method"/>
                    <field name="payment_status"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Form View: lms.payment -->
        <record id="view_lms_payment_form" model="ir.ui.view">
            <field name="name">lms.payment.form</field>
            <field name="model">lms.payment</field>
            <field name="arch" type="xml">
                <form string="Payment">
                    <header>
                        <!-- Buttons referencing model methods -->
                        <button name="action_confirm_payment" string="Confirm Payment" type="object"
                                class="oe_highlight"
                                invisible="state != 'draft'"/>
                        <button name="action_cancel_payment" string="Cancel" type="object"
                                invisible="state != 'draft'"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                                invisible="state != 'cancelled'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,pending,completed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Payment Reference" readonly="1"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="student_id" required="1" domain="[('is_student','=',True)]"/>
                                <field name="enrollment_id" required="1"/>
                                <field name="payment_plan_id"/>
                                <field name="admin_id" domain="[('is_admin','=',True)]"/>
                            </group>
                            <group>
                                <field name="course_id" readonly="1"/>
                                <field name="academic_year_id" readonly="1"/>
                                <field name="semester_id" readonly="1"/>
                                <field name="payment_status" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="date" required="1"/>
                                <field name="amount" required="1"/>
                                <field name="payment_method" required="1"/>
                                <field name="state" readonly="1"/>
                            </group>
                            <group>
                                <field name="receipt_number"/>
                                <field name="payment_date" readonly="1"/>
                                <field name="received_by" readonly="1"/>
                            </group>
                        </group>
                        
                        <!-- Additional fields for the Payment model -->
                        <group>
                            <group>
                                <field name="payment_type"/>
                                <field name="payment_reference"/>
                                <field name="payment_description" nolabel="1"/>
                            </group>
                            <group>
                                <field name="is_partial"/>
                                <field name="is_recurring"/>
                                <field name="recurring_period"/>
                                <field name="recurring_amount"/>
                                <field name="currency_id"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Transactions">
                                <field name="transaction_ids">
                                    <tree>
                                        <field name="transaction_date"/>
                                        <field name="transaction_type"/>
                                        <field name="amount"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Invoices">
                                <field name="invoice_ids">
                                    <tree>
                                        <field name="invoice_number"/>
                                        <field name="invoice_date"/>
                                        <field name="amount"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    
                    <!-- If the model has mail.thread, we can add chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Search View: lms.payment -->
        <record id="view_lms_payment_search" model="ir.ui.view">
            <field name="name">lms.payment.search</field>
            <field name="model">lms.payment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="enrollment_id"/>
                    <field name="date"/>
                    <field name="payment_method"/>
                    <field name="payment_status"/>
                    <field name="receipt_number"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Pending" name="pending" domain="[('state','=','pending')]"/>
                    <filter string="Completed" name="completed" domain="[('state','=','completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                    <filter string="Paid" name="paid" domain="[('payment_status','=','paid')]"/>
                    <filter string="Partial" name="partial" domain="[('payment_status','=','partial')]"/>
                    <filter string="Unpaid" name="unpaid" domain="[('payment_status','=','unpaid')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Student" name="group_by_student" context="{'group_by':'student_id'}"/>
                        <filter string="Enrollment" name="group_by_enrollment" context="{'group_by':'enrollment_id'}"/>
                        <filter string="State" name="group_by_state" context="{'group_by':'state'}"/>
                        <filter string="Payment Status" name="group_by_payment_status" context="{'group_by':'payment_status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Window Action: lms.payment -->
        <record id="action_lms_payment" model="ir.actions.act_window">
            <field name="name">Payments</field>
            <field name="res_model">lms.payment</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_payment_search"/>
        </record>


        <!--
          ===================================================================
          2) lms.payment.transaction views & action
          ===================================================================
        -->

        <!-- Tree View: lms.payment.transaction -->
        <record id="view_lms_payment_transaction_tree" model="ir.ui.view">
            <field name="name">lms.payment.transaction.tree</field>
            <field name="model">lms.payment.transaction</field>
            <field name="arch" type="xml">
                <tree decoration-success="state == 'completed'"
                      decoration-muted="state in ['failed','cancelled']"
                      decoration-info="state == 'pending'">
                    <field name="name"/>
                    <field name="transaction_date"/>
                    <field name="payment_id"/>
                    <field name="transaction_type"/>
                    <field name="amount"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Form View: lms.payment.transaction -->
        <record id="view_lms_payment_transaction_form" model="ir.ui.view">
            <field name="name">lms.payment.transaction.form</field>
            <field name="model">lms.payment.transaction</field>
            <field name="arch" type="xml">
                <form string="Payment Transaction">
                    <header>
                        <!-- If you want object-buttons or status changes, add here -->
                        <field name="state" widget="statusbar" statusbar_visible="draft,pending,completed,failed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Transaction Reference" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="payment_id" required="1"/>
                                <field name="transaction_date" required="1"/>
                                <field name="transaction_type" required="1"/>
                                <field name="amount" required="1"/>
                                <field name="state"/>
                            </group>
                            <group>
                                <field name="reference"/>
                                <field name="notes" nolabel="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View: lms.payment.transaction -->
        <record id="view_lms_payment_transaction_search" model="ir.ui.view">
            <field name="name">lms.payment.transaction.search</field>
            <field name="model">lms.payment.transaction</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="payment_id"/>
                    <field name="transaction_date"/>
                    <field name="transaction_type"/>
                    <field name="state"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Pending" name="pending" domain="[('state','=','pending')]"/>
                    <filter string="Completed" name="completed" domain="[('state','=','completed')]"/>
                    <filter string="Failed" name="failed" domain="[('state','=','failed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Payment" name="group_by_payment" context="{'group_by':'payment_id'}"/>
                        <filter string="Transaction Type" name="group_by_type" context="{'group_by':'transaction_type'}"/>
                        <filter string="State" name="group_by_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Window Action: lms.payment.transaction -->
        <record id="action_lms_payment_transaction" model="ir.actions.act_window">
            <field name="name">Payment Transactions</field>
            <field name="res_model">lms.payment.transaction</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_payment_transaction_search"/>
        </record>


        <!--
          ===================================================================
          3) lms.payment.invoice views & action
          ===================================================================
        -->

        <!-- Tree View: lms.payment.invoice -->
        <record id="view_lms_payment_invoice_tree" model="ir.ui.view">
            <field name="name">lms.payment.invoice.tree</field>
            <field name="model">lms.payment.invoice</field>
            <field name="arch" type="xml">
                <tree decoration-success="state == 'paid'"
                      decoration-muted="state == 'cancelled'"
                      decoration-info="state == 'sent'">
                    <field name="name"/>
                    <field name="invoice_number"/>
                    <field name="invoice_date"/>
                    <field name="due_date"/>
                    <field name="amount"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Form View: lms.payment.invoice -->
        <record id="view_lms_payment_invoice_form" model="ir.ui.view">
            <field name="name">lms.payment.invoice.form</field>
            <field name="model">lms.payment.invoice</field>
            <field name="arch" type="xml">
                <form string="Payment Invoice">
                    <header>
                        <!-- Example: Additional Buttons if you'd like to change invoice state -->
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,sent,paid,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Invoice Reference" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="payment_id" required="1"/>
                                <field name="invoice_number" required="1"/>
                                <field name="invoice_date" required="1"/>
                                <field name="due_date"/>
                                <field name="amount" required="1"/>
                                <field name="state"/>
                            </group>
                            <group>
                                <field name="notes" nolabel="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View: lms.payment.invoice -->
        <record id="view_lms_payment_invoice_search" model="ir.ui.view">
            <field name="name">lms.payment.invoice.search</field>
            <field name="model">lms.payment.invoice</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="invoice_number"/>
                    <field name="invoice_date"/>
                    <field name="due_date"/>
                    <field name="state"/>
                    <field name="amount"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Sent" name="sent" domain="[('state','=','sent')]"/>
                    <filter string="Paid" name="paid" domain="[('state','=','paid')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Payment" name="group_by_payment" context="{'group_by':'payment_id'}"/>
                        <filter string="State" name="group_by_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Window Action: lms.payment.invoice -->
        <record id="action_lms_payment_invoice" model="ir.actions.act_window">
            <field name="name">Payment Invoices</field>
            <field name="res_model">lms.payment.invoice</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_payment_invoice_search"/>
        </record>

    </data>
</odoo>
