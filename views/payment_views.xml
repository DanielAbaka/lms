<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Payment Form View -->
        <record id="view_lms_payment_form" model="ir.ui.view">
            <field name="name">lms.payment.form</field>
            <field name="model">lms.payment</field>
            <field name="arch" type="xml">
                <form string="Payment">
                    <header>
                        <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" states="draft"/>
                        <button name="action_cancel" string="Cancel" type="object" states="draft,confirmed"/>
                        <button name="action_refund" string="Refund" type="object" states="confirmed"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_transactions" type="object" class="oe_stat_button" icon="fa-exchange">
                                <field name="transaction_count" widget="statinfo" string="Transactions"/>
                            </button>
                            <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-text">
                                <field name="invoice_count" widget="statinfo" string="Invoices"/>
                            </button>
                        </div>
                        <notebook>
                            <page string="General Information">
                                <group>
                                    <group>
                                        <field name="student_id" required="1"/>
                                        <field name="enrollment_id" required="1"/>
                                        <field name="course_id" required="1"/>
                                        <field name="amount" required="1"/>
                                        <field name="payment_method" required="1"/>
                                        <field name="state"/>
                                    </group>
                                    <group>
                                        <field name="receipt_number"/>
                                        <field name="payment_date"/>
                                        <field name="received_by"/>
                                        <field name="active"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Payment Details">
                                <group>
                                    <group>
                                        <field name="currency_id"/>
                                        <field name="payment_type"/>
                                        <field name="payment_reference"/>
                                        <field name="payment_description"/>
                                    </group>
                                    <group>
                                        <field name="is_partial"/>
                                        <field name="is_recurring"/>
                                        <field name="recurring_period"/>
                                        <field name="recurring_amount"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                            <page string="Transactions">
                                <field name="transaction_ids">
                                    <tree>
                                        <field name="transaction_date"/>
                                        <field name="transaction_type"/>
                                        <field name="amount"/>
                                        <field name="reference"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Invoices">
                                <field name="invoice_ids">
                                    <tree>
                                        <field name="invoice_number"/>
                                        <field name="invoice_date"/>
                                        <field name="amount"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Payment Tree View -->
        <record id="view_lms_payment_tree" model="ir.ui.view">
            <field name="name">lms.payment.tree</field>
            <field name="model">lms.payment</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-muted="state == 'cancelled'">
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="amount"/>
                    <field name="payment_method"/>
                    <field name="receipt_number"/>
                    <field name="payment_date"/>
                    <field name="received_by"/>
                    <field name="payment_type"/>
                    <field name="is_partial"/>
                    <field name="is_recurring"/>
                    <field name="transaction_count"/>
                    <field name="invoice_count"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Payment Search View -->
        <record id="view_lms_payment_search" model="ir.ui.view">
            <field name="name">lms.payment.search</field>
            <field name="model">lms.payment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="amount"/>
                    <field name="payment_method"/>
                    <field name="receipt_number"/>
                    <field name="payment_reference"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <filter string="Partial Payments" name="partial" domain="[('is_partial', '=', True)]"/>
                    <filter string="Recurring Payments" name="recurring" domain="[('is_recurring', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}"/>
                        <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}"/>
                        <filter string="Payment Method" name="group_by_method" context="{'group_by': 'payment_method'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Partial" name="group_by_partial" context="{'group_by': 'is_partial'}"/>
                        <filter string="Recurring" name="group_by_recurring" context="{'group_by': 'is_recurring'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Payment Action -->
        <record id="action_lms_payment" model="ir.actions.act_window">
            <field name="name">Payments</field>
            <field name="res_model">lms.payment</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_payment_search"/>
        </record>

        <!-- Payments Menu Item -->
        <menuitem id="menu_lms_payments" name="Payments"
                  parent="lms_module.menu_root"
                  action="action_lms_payment" 
                  sequence="7"/>
    </data>
</odoo>