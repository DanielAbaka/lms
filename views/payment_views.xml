<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Payment Form View -->
        <record id="view_lms_payment_form" model="ir.ui.view">
            <field name="name">lms.payment.form</field>
            <field name="model">lms.payment</field>
            <field name="arch" type="xml">
                <form string="Payment">
                    <header>
                        <button name="action_confirm_payment" string="Confirm" type="object" class="oe_highlight" 
                                invisible="state != 'draft'"/>
                        <button name="action_cancel_payment" string="Cancel" type="object" 
                                invisible="state != 'draft'"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object" 
                                invisible="state != 'cancelled'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_enrollment" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                                <field name="enrollment_id" widget="statinfo" string="Enrollment"/>
                            </button>
                        </div>
                        <notebook>
                            <page string="General Information">
                                <group>
                                    <group>
                                        <field name="student_id" required="1"/>
                                        <field name="enrollment_id" required="1"/>
                                        <field name="course_id" required="1"/>
                                        <field name="amount" required="1"/>
                                        <field name="payment_method" required="1"/>
                                        <field name="state"/>
                                        <field name="payment_status"/>
                                    </group>
                                    <group>
                                        <field name="receipt_number"/>
                                        <field name="payment_date"/>
                                        <field name="received_by"/>
                                        <field name="active"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Payment Details">
                                <group>
                                    <group>
                                        <field name="currency_id"/>
                                        <field name="payment_type"/>
                                        <field name="payment_reference"/>
                                        <field name="payment_description"/>
                                    </group>
                                    <group>
                                        <field name="is_partial"/>
                                        <field name="is_recurring"/>
                                        <field name="recurring_period"/>
                                        <field name="recurring_amount"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                            <page string="Transactions">
                                <field name="transaction_ids">
                                    <tree>
                                        <field name="transaction_date"/>
                                        <field name="transaction_type"/>
                                        <field name="amount"/>
                                        <field name="reference"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Invoices">
                                <field name="invoice_ids">
                                    <tree>
                                        <field name="invoice_number"/>
                                        <field name="invoice_date"/>
                                        <field name="amount"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Payment Tree View -->
        <record id="view_lms_payment_tree" model="ir.ui.view">
            <field name="name">lms.payment.tree</field>
            <field name="model">lms.payment</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state == 'completed'" decoration-muted="state == 'cancelled'">
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="amount"/>
                    <field name="payment_method"/>
                    <field name="receipt_number"/>
                    <field name="payment_date"/>
                    <field name="received_by"/>
                    <field name="payment_status"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Payment Search View -->
        <record id="view_lms_payment_search" model="ir.ui.view">
            <field name="name">lms.payment.search</field>
            <field name="model">lms.payment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="student_id"/>
                    <field name="course_id"/>
                    <field name="amount"/>
                    <field name="payment_method"/>
                    <field name="receipt_number"/>
                    <field name="payment_reference"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                    <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <filter string="Unpaid" name="unpaid" domain="[('payment_status', '=', 'unpaid')]"/>
                    <filter string="Partial" name="partial" domain="[('payment_status', '=', 'partial')]"/>
                    <filter string="Paid" name="paid" domain="[('payment_status', '=', 'paid')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}"/>
                        <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}"/>
                        <filter string="Payment Method" name="group_by_method" context="{'group_by': 'payment_method'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Payment Status" name="group_by_payment_status" context="{'group_by': 'payment_status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Payment Action -->
        <record id="action_lms_payment" model="ir.actions.act_window">
            <field name="name">Payments</field>
            <field name="res_model">lms.payment</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_payment_search"/>
        </record>

        <!-- Payments Menu Item -->
        <menuitem id="menu_lms_payments" name="Payments"
                  parent="lms_module.menu_root"
                  action="action_lms_payment" 
                  sequence="7"/>

        <!-- Payment Plan Form View -->
        <record id="view_lms_payment_plan_form" model="ir.ui.view">
            <field name="name">lms.payment.plan.form</field>
            <field name="model">lms.payment.plan</field>
            <field name="arch" type="xml">
                <form string="Payment Plan">
                    <header>
                        <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" 
                                invisible="state != 'draft'"/>
                        <button name="action_mark_paid" string="Mark as Paid" type="object" class="oe_highlight" 
                                invisible="state != 'pending'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <field name="total_amount" widget="statinfo" string="Total Amount"/>
                            <field name="paid_amount" widget="statinfo" string="Paid Amount"/>
                            <field name="remaining_amount" widget="statinfo" string="Remaining"/>
                        </div>
                        <notebook>
                            <page string="Payment Details">
                                <group>
                                    <group>
                                        <field name="name" required="1"/>
                                        <field name="enrollment_id" required="1"/>
                                        <field name="total_amount" required="1"/>
                                        <field name="state"/>
                                    </group>
                                    <group>
                                        <field name="paid_amount"/>
                                        <field name="remaining_amount"/>
                                        <field name="payment_method"/>
                                        <field name="due_date"/>
                                    </group>
                                </group>
                                <group string="Notes">
                                    <field name="notes"/>
                                </group>
                            </page>
                            <page string="Payment History">
                                <field name="payment_ids">
                                    <tree>
                                        <field name="date"/>
                                        <field name="amount"/>
                                        <field name="payment_method"/>
                                        <field name="reference"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Payment Plan Tree View -->
        <record id="view_lms_payment_plan_tree" model="ir.ui.view">
            <field name="name">lms.payment.plan.tree</field>
            <field name="model">lms.payment.plan</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-warning="state == 'pending'" decoration-success="state == 'paid'">
                    <field name="name"/>
                    <field name="enrollment_id"/>
                    <field name="total_amount"/>
                    <field name="paid_amount"/>
                    <field name="remaining_amount"/>
                    <field name="due_date"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Payment Plan Search View -->
        <record id="view_lms_payment_plan_search" model="ir.ui.view">
            <field name="name">lms.payment.plan.search</field>
            <field name="model">lms.payment.plan</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="enrollment_id"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                    <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                    <filter string="Overdue" name="overdue" domain="[('due_date', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', '=', 'pending')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Enrollment" name="group_by_enrollment" context="{'group_by': 'enrollment_id'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Due Date" name="group_by_due_date" context="{'group_by': 'due_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Payment Plan Calendar View -->
        <record id="view_lms_payment_plan_calendar" model="ir.ui.view">
            <field name="name">lms.payment.plan.calendar</field>
            <field name="model">lms.payment.plan</field>
            <field name="arch" type="xml">
                <calendar string="Payment Due Dates" date_start="due_date" color="state">
                    <field name="name"/>
                    <field name="enrollment_id"/>
                    <field name="total_amount"/>
                    <field name="remaining_amount"/>
                    <field name="state"/>
                </calendar>
            </field>
        </record>

        <!-- Payment Plan Actions -->
        <record id="action_lms_payment_plans" model="ir.actions.act_window">
            <field name="name">Payment Plans</field>
            <field name="res_model">lms.payment.plan</field>
            <field name="view_mode">tree,form,calendar</field>
            <field name="search_view_id" ref="view_lms_payment_plan_search"/>
        </record>

        <!-- Payment Plan Menu -->
        <menuitem id="menu_lms_payment_plans"
                  name="Payment Plans"
                  parent="lms_module.menu_root"
                  action="action_lms_payment_plans"
                  sequence="6"/>
    </data>
</odoo>