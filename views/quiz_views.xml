<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Quiz Form View -->
        <record id="view_lms_quiz_form" model="ir.ui.view">
            <field name="name">lms.quiz.form</field>
            <field name="model">lms.quiz</field>
            <field name="arch" type="xml">
                <form string="Quiz">
                    <header>
                        <button name="action_publish" string="Publish" type="object" class="oe_highlight" states="draft"/>
                        <button name="action_start" string="Start" type="object" class="oe_highlight" states="published"/>
                        <button name="action_complete" string="Complete" type="object" class="oe_highlight" states="in_progress"/>
                        <button name="action_cancel" string="Cancel" type="object" states="draft,published"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object" states="cancelled"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_attempts" type="object" class="oe_stat_button" icon="fa-users">
                                <field name="attempt_count" widget="statinfo" string="Attempts"/>
                            </button>
                            <button name="action_view_grades" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                                <field name="pass_rate" widget="statinfo" string="Pass Rate"/>
                            </button>
                        </div>
                        <notebook>
                            <page string="General Information">
                                <group>
                                    <group>
                                        <field name="name" required="1"/>
                                        <field name="teacher_assignment_id" required="1"/>
                                        <field name="description"/>
                                    </group>
                                    <group>
                                        <field name="start_date" required="1"/>
                                        <field name="end_date" required="1"/>
                                        <field name="duration" required="1"/>
                                        <field name="max_attempts"/>
                                        <field name="show_results"/>
                                    </group>
                                </group>
                                <group string="Scoring">
                                    <field name="total_points" required="1"/>
                                    <field name="passing_score" required="1"/>
                                </group>
                            </page>
                            <page string="Questions">
                                <field name="question_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="question_type"/>
                                        <field name="points"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Attempts">
                                <field name="attempt_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="duration"/>
                                        <field name="score"/>
                                        <field name="percentage"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Grades">
                                <field name="grade_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="grade"/>
                                        <field name="date"/>
                                        <field name="graded_by"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Quiz Tree View -->
        <record id="view_lms_quiz_tree" model="ir.ui.view">
            <field name="name">lms.quiz.tree</field>
            <field name="model">lms.quiz</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state == 'completed'" decoration-warning="state == 'in_progress'">
                    <field name="name"/>
                    <field name="teacher_assignment_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="duration"/>
                    <field name="total_points"/>
                    <field name="attempt_count"/>
                    <field name="average_score"/>
                    <field name="pass_rate"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Quiz Search View -->
        <record id="view_lms_quiz_search" model="ir.ui.view">
            <field name="name">lms.quiz.search</field>
            <field name="model">lms.quiz</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="teacher_assignment_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Published" name="published" domain="[('state', '=', 'published')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Teacher Assignment" name="group_by_assignment" context="{'group_by': 'teacher_assignment_id'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Quiz Action -->
        <record id="action_lms_quiz" model="ir.actions.act_window">
            <field name="name">Quizzes</field>
            <field name="res_model">lms.quiz</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_quiz_search"/>
        </record>

        <!-- Quiz Menu Item -->
        <menuitem id="menu_lms_quiz" name="Quizzes"
                  parent="lms_module.menu_root"
                  action="action_lms_quiz"
                  sequence="8"/>
    </data>
</odoo> 