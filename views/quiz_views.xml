<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Quiz Preview View for lms.quiz -->
    <record id="view_lms_quiz_preview" model="ir.ui.view">
      <field name="name">lms.quiz.preview</field>
      <field name="model">lms.quiz</field>
      <field name="arch" type="xml">
        <form string="Quiz Preview">
          <header>
            <button name="action_publish" string="Publish" type="object" class="oe_highlight"
                    invisible="state != 'draft'"/>
            <button name="action_start" string="Start" type="object" class="oe_highlight"
                    invisible="state != 'published'"/>
            <button name="action_complete" string="Complete" type="object" class="oe_highlight"
                    invisible="state != 'in_progress'"/>
            <button name="action_cancel" string="Cancel" type="object"
                    invisible="state not in ('draft','published')"/>
            <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                    invisible="state != 'cancelled'"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,published,in_progress,completed,cancelled"/>
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <!-- Button to view attempts -->
              <button name="action_view_attempts" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                <field name="attempt_count" widget="statinfo" string="Attempts"/>
              </button>
              <field name="average_score" widget="statinfo" string="Avg Score"/>
            </div>
            <notebook>
              <page string="Quiz Details">
                <group>
                  <group>
                    <field name="name" required="1"/>
                    <field name="code" required="1"/>
                    <field name="teacher_assignment_id" required="1"/>
                    <field name="course_id" readonly="1"/>
                    <field name="duration"/>
                    <field name="passing_score"/>
                  </group>
                  <group>
                    <field name="total_points"/>
                    <field name="max_attempts"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="show_results"/>
                    <field name="state"/>
                  </group>
                </group>
                <group string="Description">
                  <field name="description" nolabel="1"/>
                </group>
              </page>
              <page string="Statistics">
                <group>
                  <group>
                    <field name="attempt_count"/>
                    <field name="average_score"/>
                    <field name="pass_rate"/>
                  </group>
                </group>
              </page>
              <page string="Attempts">
                <field name="attempt_ids">
                  <tree>
                    <field name="student_id"/>
                    <field name="date"/>
                    <field name="grade"/>
                    <field name="state"/>
                  </tree>
                </field>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
          </div>
        </form>
      </field>
    </record>
    
    <!-- Action for Quizzes -->
    <record id="action_lms_quizzes" model="ir.actions.act_window">
        <field name="name">Quizzes</field>
        <field name="res_model">lms.quiz</field>
        <field name="view_mode">tree,form</field>
    </record>
  </data>
</odoo>
