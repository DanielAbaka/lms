<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Quiz Preview View -->
        <record id="view_lms_quiz_preview" model="ir.ui.view">
            <field name="name">lms.quiz.preview</field>
            <field name="model">lms.quiz</field>
            <field name="arch" type="xml">
                <form string="Quiz Preview">
                    <header>
                        <button name="action_start" string="Start Quiz" type="object" class="oe_highlight" 
                                invisible="state != 'published'"/>
                        <button name="action_publish" string="Publish" type="object" class="oe_highlight" 
                                invisible="state != 'draft'"/>
                        <button name="action_complete" string="Complete" type="object" class="oe_highlight" 
                                invisible="state != 'in_progress'"/>
                        <button name="action_cancel" string="Cancel" type="object" 
                                invisible="state not in ('draft', 'published')"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object" 
                                invisible="state != 'cancelled'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                            <h2><field name="description"/></h2>
                        </div>
                        <notebook>
                            <page string="Questions">
                                <field name="question_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="question_type"/>
                                        <field name="points"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Settings">
                                <group>
                                    <group>
                                        <field name="duration"/>
                                        <field name="passing_score"/>
                                        <field name="max_attempts"/>
                                    </group>
                                    <group>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="state"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Quiz Form View -->
        <record id="view_lms_quiz_form" model="ir.ui.view">
            <field name="name">lms.quiz.form</field>
            <field name="model">lms.quiz</field>
            <field name="arch" type="xml">
                <form string="Quiz">
                    <header>
                        <button name="action_publish" string="Publish" type="object" class="oe_highlight"
                               invisible="state != 'draft'"/>
                        <button name="action_start" string="Start" type="object" class="oe_highlight" 
                                invisible="state != 'published'"/>
                        <button name="action_complete" string="Complete" type="object" class="oe_highlight" 
                                invisible="state != 'in_progress'"/>
                        <button name="action_cancel" string="Cancel" type="object" 
                                invisible="state not in ('draft', 'published')"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object" 
                                invisible="state != 'cancelled'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <field name="attempt_count" widget="statinfo" string="Attempts"/>
                            <field name="average_score" widget="statinfo" string="Avg Score"/>
                        </div>
                        <notebook>
                            <page string="Quiz Details">
                                <group>
                                    <group>
                                        <field name="name" required="1"/>
                                        <field name="course_id" required="1"/>
                                        <field name="duration"/>
                                        <field name="passing_score"/>
                                    </group>
                                    <group>
                                        <field name="max_attempts"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="state"/>
                                    </group>
                                </group>
                                <group string="Description">
                                    <field name="description"/>
                                </group>
                            </page>
                            <page string="Questions">
                                <field name="question_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="question_type"/>
                                        <field name="points"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Attempts">
                                <field name="attempt_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="start_time"/>
                                        <field name="end_time"/>
                                        <field name="score"/>
                                        <field name="status"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Quiz Tree View -->
        <record id="view_lms_quiz_tree" model="ir.ui.view">
            <field name="name">lms.quiz.tree</field>
            <field name="model">lms.quiz</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state == 'active'">
                    <field name="name"/>
                    <field name="course_id"/>
                    <field name="duration"/>
                    <field name="attempt_count"/>
                    <field name="average_score"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Quiz Search View -->
        <record id="view_lms_quiz_search" model="ir.ui.view">
            <field name="name">lms.quiz.search</field>
            <field name="model">lms.quiz</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="course_id"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                    <filter string="Archived" name="archived" domain="[('state', '=', 'archived')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Quiz Actions -->
        <record id="action_lms_quizzes" model="ir.actions.act_window">
            <field name="name">Quizzes</field>
            <field name="res_model">lms.quiz</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_quiz_search"/>
        </record>

        <record id="action_lms_quiz_preview" model="ir.actions.act_window">
            <field name="name">Quiz Preview</field>
            <field name="res_model">lms.quiz</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'form_view_initial_mode': 'readonly'}</field>
        </record>

        <!-- Quiz Menu Item -->
        <menuitem id="menu_lms_quiz" name="Quizzes"
                  parent="lms_module.menu_root"
                  action="action_lms_quizzes"
                  sequence="8"/>
    </data>
</odoo> 