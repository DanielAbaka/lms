<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================== -->
        <!-- 1) TREE VIEW: lms.quiz       -->
        <!-- ============================== -->
        <record id="view_lms_quiz_tree" model="ir.ui.view">
            <field name="name">lms.quiz.tree</field>
            <field name="model">lms.quiz</field>
            <field name="arch" type="xml">
                <!-- 
                  You can use decoration attributes to highlight rows based on state
                  e.g. decoration-info="state == 'draft'", decoration-success="state == 'completed'"
                -->
                <tree decoration-info="state == 'draft'"
                      decoration-muted="state == 'cancelled'"
                      decoration-success="state == 'completed'">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="course_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="passing_score"/>
                    <field name="max_attempts"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- ============================== -->
        <!-- 2) FORM VIEW: lms.quiz       -->
        <!-- ============================== -->
        <record id="view_lms_quiz_form" model="ir.ui.view">
            <field name="name">lms.quiz.form</field>
            <field name="model">lms.quiz</field>
            <field name="arch" type="xml">
                <form string="Quiz">
                    <header>
                        <!-- Buttons for state transitions -->
                        <button name="action_publish" string="Publish" type="object"
                                class="oe_highlight"
                                attrs="{'invisible':[('state','!=','draft')]}"/>
                        <button name="action_start" string="Start" type="object"
                                attrs="{'invisible':[('state','!=','published')]}" />
                        <button name="action_complete" string="Complete" type="object"
                                attrs="{'invisible':[('state','!=','in_progress')]}" />
                        <button name="action_cancel" string="Cancel" type="object"
                                attrs="{'invisible':[('state','not in',['draft','published'])]}" />
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                                attrs="{'invisible':[('state','!=','cancelled')]}" />

                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,published,in_progress,completed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Quiz Title"/></h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="code" required="1"/>
                                <field name="teacher_assignment_id" required="1"/>
                                <field name="course_id" readonly="1"/>
                                <field name="academic_year_id" readonly="1"/>
                                <field name="semester_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="start_date" required="1"/>
                                <field name="end_date" required="1"/>
                                <field name="duration" required="1"/>
                                <field name="total_points" required="1"/>
                                <field name="passing_score" required="1"/>
                                <field name="max_attempts"/>
                            </group>
                        </group>

                        <group>
                            <group>
                                <field name="description" nolabel="1"/>
                            </group>
                            <group>
                                <field name="show_results"/>
                                <field name="active"/>
                                <field name="state" readonly="1"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Statistics">
                                <group>
                                    <field name="question_count" readonly="1"/>
                                    <field name="attempt_count" readonly="1"/>
                                    <field name="average_score" readonly="1"/>
                                    <field name="pass_rate" readonly="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================== -->
        <!-- 3) SEARCH VIEW: lms.quiz     -->
        <!-- ============================== -->
        <record id="view_lms_quiz_search" model="ir.ui.view">
            <field name="name">lms.quiz.search</field>
            <field name="model">lms.quiz</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="course_id"/>
                    <field name="teacher_assignment_id"/>
                    <field name="state"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Published" name="published" domain="[('state','=','published')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('state','=','in_progress')]"/>
                    <filter string="Completed" name="completed" domain="[('state','=','completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}"/>
                        <filter string="Teacher Assignment" name="group_by_assignment" context="{'group_by': 'teacher_assignment_id'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================== -->
        <!-- 4) ACTION: lms.quiz           -->
        <!-- ============================== -->
        <record id="action_lms_quiz" model="ir.actions.act_window">
            <field name="name">Quizzes</field>
            <field name="res_model">lms.quiz</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_quiz_search"/>
        </record>

        <!-- 
          If you manage menus in another file, you might add:
          <menuitem id="menu_lms_quiz"
                    name="Quizzes"
                    parent="lms_module.menu_root"
                    action="action_lms_quiz"
                    sequence="10"/>
        -->

    </data>
</odoo>
