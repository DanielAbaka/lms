<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Quiz Form View -->
    <record id="view_lms_quiz_form" model="ir.ui.view">
      <field name="name">lms.quiz.form</field>
      <field name="model">lms.quiz</field>
      <field name="arch" type="xml">
        <form string="Quiz">
          <header>
            <button name="action_publish" string="Publish" type="object" class="oe_highlight" invisible="state != 'draft'"/>
            <button name="action_start" string="Start" type="object" class="oe_highlight" invisible="state != 'published'"/>
            <button name="action_complete" string="Complete" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
            <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft','published')"/>
            <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,published,in_progress,completed,cancelled"/>
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <!-- Preview button (if an action exists for preview) -->
              <button name="%(action_lms_quiz_preview)d" type="action" class="oe_stat_button" icon="fa-eye" string="Preview"/>
              <!-- Display total points as an example statistic -->
              <field name="total_points" widget="statinfo" string="Total Points"/>
            </div>
            <notebook>
              <page string="Quiz Details">
                <group>
                  <group>
                    <field name="name" required="1"/>
                    <field name="code" required="1"/>
                    <field name="teacher_assignment_id" required="1"/>
                    <field name="course_id" readonly="1"/>
                  </group>
                  <group>
                    <field name="duration"/>
                    <field name="passing_score"/>
                    <field name="max_attempts"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="show_results"/>
                    <field name="state"/>
                  </group>
                </group>
                <group string="Description">
                  <field name="description" nolabel="1"/>
                </group>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
          </div>
        </form>
      </field>
    </record>

    <!-- Quiz Tree View -->
    <record id="view_lms_quiz_tree" model="ir.ui.view">
      <field name="name">lms.quiz.tree</field>
      <field name="model">lms.quiz</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="code"/>
          <field name="course_id"/>
          <field name="state"/>
        </tree>
      </field>
    </record>
  </data>
</odoo>
