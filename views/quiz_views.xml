<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Quiz Preview View -->
        <record id="view_lms_quiz_preview" model="ir.ui.view">
            <field name="name">lms.quiz.preview</field>
            <field name="model">lms.quiz</field>
            <field name="arch" type="xml">
                <form string="Quiz Preview">
                    <header>
                        <!-- optional, or remove if you prefer a read-only form for preview -->
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                            <h2><field name="description"/></h2>
                        </div>
                        <notebook>
                            <page string="Questions">
                                <field name="question_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="question_type"/>
                                        <field name="points"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Settings">
                                <group>
                                    <group>
                                        <field name="duration"/>
                                        <field name="passing_score"/>
                                        <field name="max_attempts"/>
                                    </group>
                                    <group>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="state"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Quiz Form View -->
        <record id="view_lms_quiz_form" model="ir.ui.view">
            <field name="name">lms.quiz.form</field>
            <field name="model">lms.quiz</field>
            <field name="arch" type="xml">
                <form string="Quiz">
                    <header>
                        <!-- Buttons controlling state transitions, each with an invisible attribute -->
                        <button name="action_publish" string="Publish" type="object" class="oe_highlight" 
                                invisible="state != 'draft'"/>
                        <button name="action_start" string="Start" type="object" class="oe_highlight" 
                                invisible="state != 'published'"/>
                        <button name="action_complete" string="Complete" type="object" class="oe_highlight" 
                                invisible="state != 'in_progress'"/>
                        <button name="action_cancel" string="Cancel" type="object" 
                                invisible="state not in ('draft','published')"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object" 
                                invisible="state != 'cancelled'"/>

                        <!-- Statusbar widget for the state -->
                        <field name="state" widget="statusbar" statusbar_visible="draft,published,in_progress,completed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <!-- Example: a button to open a preview action -->
                            <button name="%(action_lms_quiz_preview)d" type="action" class="oe_stat_button" icon="fa-eye" string="Preview"/>
                            <!-- Another button to open attempts -->
                            <button type="object" class="oe_stat_button" icon="fa-pencil-square-o" name="action_view_attempts">
                                <field name="attempt_count" widget="statinfo" string="Attempts"/>
                            </button>
                            <field name="average_score" widget="statinfo" string="Avg Score"/>
                        </div>
                        <notebook>
                            <page string="Quiz Details">
                                <group>
                                    <group>
                                        <field name="name" required="1"/>
                                        <field name="code" required="1"/>
                                        <field name="teacher_assignment_id" required="1"/>
                                        <field name="course_id" readonly="1"/>
                                        <field name="duration"/>
                                        <field name="passing_score"/>
                                    </group>
                                    <group>
                                        <field name="total_points"/>
                                        <field name="max_attempts"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="show_results"/>
                                        <field name="state"/>
                                    </group>
                                </group>
                                <group string="Description">
                                    <field name="description" nolabel="1"/>
                                </group>
                            </page>
                            <page string="Questions">
                                <field name="question_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="question_type"/>
                                        <field name="points"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Attempts">
                                <field name="attempt_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="score"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Quiz Tree View -->
        <record id="view_lms_quiz_tree" model="ir.ui.view">
            <field name="name">lms.quiz.tree</field>
            <field name="model">lms.quiz</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state in ['completed','in_progress']" decoration-muted="state=='cancelled'">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="teacher_assignment_id"/>
                    <field name="course_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Quiz Search View -->
        <record id="view_lms_quiz_search" model="ir.ui.view">
            <field name="name">lms.quiz.search</field>
            <field name="model">lms.quiz</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="teacher_assignment_id"/>
                    <field name="course_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Published" name="published" domain="[('state','=','published')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('state','=','in_progress')]"/>
                    <filter string="Completed" name="completed" domain="[('state','=','completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter string="State" name="group_by_state" context="{'group_by':'state'}"/>
                        <filter string="Course" name="group_by_course" context="{'group_by':'course_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Quiz Action -->
        <record id="action_lms_quizzes" model="ir.actions.act_window">
            <field name="name">Quizzes</field>
            <field name="res_model">lms.quiz</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_quiz_search"/>
        </record>

        <!-- Quiz Preview Action -->
        <record id="action_lms_quiz_preview" model="ir.actions.act_window">
            <field name="name">Quiz Preview</field>
            <field name="res_model">lms.quiz</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_lms_quiz_preview"/>
            <field name="target">new</field>
            <!-- Typically read-only, so you can do context="{'form_view_initial_mode':'readonly'}" -->
        </record>

        <!-- Quiz Menu Item -->
        <menuitem id="menu_lms_quiz" name="Quizzes"
                  parent="lms_module.menu_root"
                  action="action_lms_quizzes"
                  sequence="8"/>
    </data>
</odoo>
