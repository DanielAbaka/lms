<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- ================================================ -->
        <!-- 1) TREE VIEW: lms.semester                      -->
        <!-- ================================================ -->
        <record id="view_lms_semester_tree" model="ir.ui.view">
            <field name="name">lms.semester.tree</field>
            <field name="model">lms.semester</field>
            <field name="arch" type="xml">
                <!-- 
                  You can decorate rows based on state, e.g. 
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'active'"
                  decoration-muted="state in ['completed','cancelled']"
                -->
                <tree decoration-info="state == 'draft'"
                      decoration-success="state == 'active'"
                      decoration-muted="state in ['completed','cancelled']">
                    <field name="academic_year_id"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="sequence"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="enrollment_start"/>
                    <field name="enrollment_end"/>
                    <field name="student_count"/>
                    <field name="course_count"/>
                    <field name="teacher_count"/>
                    <field name="enrollment_count"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- ================================================ -->
        <!-- 2) FORM VIEW: lms.semester                      -->
        <!-- ================================================ -->
        <record id="view_lms_semester_form" model="ir.ui.view">
            <field name="name">lms.semester.form</field>
            <field name="model">lms.semester</field>
            <field name="arch" type="xml">
                <form string="Academic Semester">
                    <header>
                        <!-- Buttons for state transitions -->
                        <button name="action_activate" string="Activate" type="object" class="oe_highlight"
                                invisible="state != 'draft'" />
                        <button name="action_complete" string="Complete" type="object" class="oe_highlight"
                                invisible="state != 'active'" />
                        <button name="action_cancel" string="Cancel" type="object"
                                invisible="state not in ('draft', 'active')" />
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                                invisible="state != 'cancelled'" />
                        <field name="state" widget="statusbar" 
                               statusbar_visible="draft,active,completed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Semester Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="academic_year_id" required="1"/>
                                <field name="admin_id" domain="[('is_admin','=',True)]"/>
                                <field name="sequence" required="1"/>
                                <field name="code" required="1"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="start_date" required="1"/>
                                <field name="end_date" required="1"/>
                                <field name="enrollment_start"/>
                                <field name="enrollment_end"/>
                                <field name="add_drop_start"/>
                                <field name="add_drop_end"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="student_count" readonly="1"/>
                                <field name="course_count" readonly="1"/>
                            </group>
                            <group>
                                <field name="teacher_count" readonly="1"/>
                                <field name="enrollment_count" readonly="1"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Courses">
                                <button name="action_view_courses" type="object" class="oe_stat_button" icon="fa-book">
                                    <field name="course_count" widget="statinfo" string="Courses"/>
                                </button>
                                <field name="course_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="credits"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Teacher Assignments">
                                <field name="teacher_assignment_ids">
                                    <tree>
                                        <field name="teacher_id"/>
                                        <field name="course_id"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Enrollments">
                                <button name="action_view_enrollments" type="object" class="oe_stat_button" icon="fa-users">
                                    <field name="enrollment_count" widget="statinfo" string="Enrollments"/>
                                </button>
                                <field name="enrollment_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="course_id"/>
                                        <field name="enrollment_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Quizzes">
                                <field name="quiz_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Grades">
                                <field name="grade_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="course_id"/>
                                        <field name="grade"/>
                                        <field name="grade_type"/>
                                        <field name="date"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Documents">
                                <field name="document_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="date"/>
                                        <field name="file_type"/>
                                        <field name="is_public"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- chatter if needed (mail.thread) -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ================================================ -->
        <!-- 3) SEARCH VIEW: lms.semester                    -->
        <!-- ================================================ -->
        <record id="view_lms_semester_search" model="ir.ui.view">
            <field name="name">lms.semester.search</field>
            <field name="model">lms.semester</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="academic_year_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Active" name="active" domain="[('state','=','active')]"/>
                    <filter string="Completed" name="completed" domain="[('state','=','completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Academic Year" name="group_by_academic_year" context="{'group_by':'academic_year_id'}"/>
                        <filter string="State" name="group_by_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ================================================ -->
        <!-- 4) ACTION: lms.semester                         -->
        <!-- ================================================ -->
        <record id="action_lms_semester" model="ir.actions.act_window">
            <field name="name">Semesters</field>
            <field name="res_model">lms.semester</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_semester_search"/>
        </record>

        <!-- 
          If your menu is in another file, you can do something like:
          <menuitem id="menu_lms_semesters"
                    name="Semesters"
                    parent="lms_module.menu_root"
                    action="action_lms_semester"
                    sequence="10"/>
        -->

    </data>
</odoo>
