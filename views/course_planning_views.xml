<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Course Planning Form View -->
        <record id="view_lms_course_planning_form" model="ir.ui.view">
            <field name="name">lms.course.planning.form</field>
            <field name="model">lms.course.planning</field>
            <field name="arch" type="xml">
                <form string="Course Planning">
                    <header>
                        <button name="action_activate" string="Activate" type="object" class="oe_highlight" states="draft"/>
                        <button name="action_complete" string="Complete" type="object" class="oe_highlight" states="active"/>
                        <button name="action_cancel" string="Cancel" type="object" states="draft,active"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object" states="cancelled"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_enrollments" type="object" class="oe_stat_button" icon="fa-users">
                                <field name="enrollment_count" widget="statinfo" string="Enrollments"/>
                            </button>
                            <button name="action_view_courses" type="object" class="oe_stat_button" icon="fa-book">
                                <field name="course_count" widget="statinfo" string="Courses"/>
                            </button>
                        </div>
                        <notebook>
                            <page string="General Information">
                                <group>
                                    <group>
                                        <field name="student_id" required="1"/>
                                        <field name="semester_id" required="1"/>
                                        <field name="enrollment_id"/>
                                        <field name="is_enrolled"/>
                                        <field name="state"/>
                                    </group>
                                    <group>
                                        <field name="total_credits"/>
                                        <field name="total_cost"/>
                                        <field name="active"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Planned Courses">
                                <field name="planned_course_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="course_id"/>
                                        <field name="credits"/>
                                        <field name="cost"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Enrollments">
                                <field name="enrollment_ids">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="course_id"/>
                                        <field name="enrollment_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Courses">
                                <field name="course_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="credits"/>
                                        <field name="enrollment_count"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Course Planning Tree View -->
        <record id="view_lms_course_planning_tree" model="ir.ui.view">
            <field name="name">lms.course.planning.tree</field>
            <field name="model">lms.course.planning</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-muted="state in ['completed', 'cancelled']">
                    <field name="student_id"/>
                    <field name="semester_id"/>
                    <field name="enrollment_id"/>
                    <field name="is_enrolled"/>
                    <field name="total_credits"/>
                    <field name="total_cost"/>
                    <field name="enrollment_count"/>
                    <field name="course_count"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Course Planning Search View -->
        <record id="view_lms_course_planning_search" model="ir.ui.view">
            <field name="name">lms.course.planning.search</field>
            <field name="model">lms.course.planning</field>
            <field name="arch" type="xml">
                <search>
                    <field name="student_id"/>
                    <field name="semester_id"/>
                    <field name="enrollment_id"/>
                    <field name="total_credits"/>
                    <field name="total_cost"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                    <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <filter string="Enrolled" name="enrolled" domain="[('is_enrolled', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}"/>
                        <filter string="Semester" name="group_by_semester" context="{'group_by': 'semester_id'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Enrolled" name="group_by_enrolled" context="{'group_by': 'is_enrolled'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Course Planning Action -->
        <record id="action_lms_course_planning" model="ir.actions.act_window">
            <field name="name">Course Planning</field>
            <field name="res_model">lms.course.planning</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_course_planning_search"/>
        </record>

        <!-- Course Planning Menu Item -->
        <menuitem id="menu_lms_course_planning" name="Course Planning"
                  parent="lms_module.menu_root"
                  action="action_lms_course_planning" 
                  sequence="6"/>
    </data>
</odoo>