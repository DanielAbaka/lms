<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ======================= -->
        <!-- 1) TREE VIEW           -->
        <!-- ======================= -->
        <record id="view_lms_course_planning_tree" model="ir.ui.view">
            <field name="name">lms.course.planning.tree</field>
            <field name="model">lms.course.planning</field>
            <field name="arch" type="xml">
                <tree decoration-success="is_enrolled == True">
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="semester_id"/>
                    <field name="total_credits"/>
                    <field name="total_cost"/>
                    <!-- Show enrollment_id or is_enrolled to see if the student was enrolled -->
                    <field name="is_enrolled"/>
                </tree>
            </field>
        </record>

        <!-- ======================= -->
        <!-- 2) FORM VIEW           -->
        <!-- ======================= -->
        <record id="view_lms_course_planning_form" model="ir.ui.view">
            <field name="name">lms.course.planning.form</field>
            <field name="model">lms.course.planning</field>
            <field name="arch" type="xml">
                <form string="Course Planning">
                    <header>
                        <!-- 
                          Enroll Student button calls enroll_student method.
                          Only visible if not already enrolled.
                        -->
                        <button name="enroll_student" type="object" string="Enroll Student"
                                class="oe_highlight"
                                attrs="{'invisible':[('is_enrolled','=',True)]}"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Planning Reference" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="student_id" required="1"/>
                                <field name="semester_id" required="1"/>
                                <field name="is_enrolled" readonly="1"/>
                            </group>
                            <group>
                                <field name="total_credits" readonly="1"/>
                                <field name="total_cost" readonly="1"/>
                                <field name="enrollment_id" readonly="1"/>
                            </group>
                        </group>
                        <group string="Planned Courses">
                            <!-- 
                              Many2many of course_ids. 
                              Possibly allow adding from a tree or tags approach 
                            -->
                            <field name="course_ids" widget="many2many_tags"/>
                        </group>
                    </sheet>
                    <!-- 
                      If you want mail.thread, you can add chatter here:
                      <div class="oe_chatter">
                          <field name="message_follower_ids"/>
                          <field name="activity_ids"/>
                          <field name="message_ids"/>
                      </div>
                    -->
                </form>
            </field>
        </record>

        <!-- ======================= -->
        <!-- 3) SEARCH VIEW         -->
        <!-- ======================= -->
        <record id="view_lms_course_planning_search" model="ir.ui.view">
            <field name="name">lms.course.planning.search</field>
            <field name="model">lms.course.planning</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="semester_id"/>
                    <separator/>
                    <filter string="Enrolled" name="enrolled" domain="[('is_enrolled','=',True)]"/>
                    <filter string="Not Enrolled" name="not_enrolled" domain="[('is_enrolled','=',False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Student" name="group_by_student" context="{'group_by':'student_id'}"/>
                        <filter string="Semester" name="group_by_semester" context="{'group_by':'semester_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ======================= -->
        <!-- 4) ACTION              -->
        <!-- ======================= -->
        <record id="action_lms_course_planning" model="ir.actions.act_window">
            <field name="name">Course Planning</field>
            <field name="res_model">lms.course.planning</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_course_planning_search"/>
        </record>

        <!-- 
          Then, in your separate menu file:
          
          <menuitem id="menu_lms_course_planning"
                    name="Course Planning"
                    parent="lms_module.menu_root"
                    action="action_lms_course_planning"
                    sequence="10"/>
        -->
    </data>
</odoo>
