<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Student Portal Form View -->
        <record id="view_lms_student_portal_form" model="ir.ui.view">
            <field name="name">lms.student.portal.form</field>
            <field name="model">lms.student.portal</field>
            <field name="arch" type="xml">
                <form string="Student Portal">
                    <header>
                        <button name="action_activate" string="Activate" type="object" class="oe_highlight" states="draft"/>
                        <button name="action_complete" string="Complete" type="object" class="oe_highlight" states="active"/>
                        <button name="action_cancel" string="Cancel" type="object" states="draft,active"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object" states="cancelled"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_enrollments" type="object" class="oe_stat_button" icon="fa-users">
                                <field name="enrollment_count" widget="statinfo" string="Enrollments"/>
                            </button>
                            <button name="action_view_grades" type="object" class="oe_stat_button" icon="fa-star">
                                <field name="grade_count" widget="statinfo" string="Grades"/>
                            </button>
                            <button name="action_view_transcripts" type="object" class="oe_stat_button" icon="fa-file-text">
                                <field name="transcript_count" widget="statinfo" string="Transcripts"/>
                            </button>
                        </div>
                        <notebook>
                            <page string="General Information">
                                <group>
                                    <group>
                                        <field name="student_id" required="1"/>
                                        <field name="academic_year_id" required="1"/>
                                        <field name="semester_id" required="1"/>
                                        <field name="state"/>
                                    </group>
                                    <group>
                                        <field name="gpa"/>
                                        <field name="total_credits"/>
                                        <field name="active"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Academic Summary">
                                <group>
                                    <group>
                                        <field name="total_courses"/>
                                        <field name="courses_completed"/>
                                        <field name="courses_in_progress"/>
                                        <field name="courses_failed"/>
                                    </group>
                                    <group>
                                        <field name="total_credits_attempted"/>
                                        <field name="total_credits_earned"/>
                                        <field name="total_credits_in_progress"/>
                                        <field name="total_credits_failed"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Enrollments">
                                <field name="enrollment_ids">
                                    <tree>
                                        <field name="course_id"/>
                                        <field name="enrollment_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Grades">
                                <field name="grade_ids">
                                    <tree>
                                        <field name="course_id"/>
                                        <field name="grade"/>
                                        <field name="credits"/>
                                        <field name="grade_letter"/>
                                        <field name="grade_point"/>
                                        <field name="grade_status"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Transcripts">
                                <field name="transcript_ids">
                                    <tree>
                                        <field name="academic_year_id"/>
                                        <field name="semester_id"/>
                                        <field name="gpa"/>
                                        <field name="total_credits"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Payments">
                                <field name="payment_ids">
                                    <tree>
                                        <field name="course_id"/>
                                        <field name="amount"/>
                                        <field name="payment_method"/>
                                        <field name="payment_date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Documents">
                                <field name="document_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="date"/>
                                        <field name="is_public"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Student Portal Tree View -->
        <record id="view_lms_student_portal_tree" model="ir.ui.view">
            <field name="name">lms.student.portal.tree</field>
            <field name="model">lms.student.portal</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-muted="state in ['completed', 'cancelled']">
                    <field name="student_id"/>
                    <field name="academic_year_id"/>
                    <field name="semester_id"/>
                    <field name="gpa"/>
                    <field name="total_credits"/>
                    <field name="total_courses"/>
                    <field name="courses_completed"/>
                    <field name="courses_in_progress"/>
                    <field name="courses_failed"/>
                    <field name="enrollment_count"/>
                    <field name="grade_count"/>
                    <field name="transcript_count"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Student Portal Search View -->
        <record id="view_lms_student_portal_search" model="ir.ui.view">
            <field name="name">lms.student.portal.search</field>
            <field name="model">lms.student.portal</field>
            <field name="arch" type="xml">
                <search>
                    <field name="student_id"/>
                    <field name="academic_year_id"/>
                    <field name="semester_id"/>
                    <field name="gpa"/>
                    <field name="total_credits"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                    <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}"/>
                        <filter string="Academic Year" name="group_by_academic_year" context="{'group_by': 'academic_year_id'}"/>
                        <filter string="Semester" name="group_by_semester" context="{'group_by': 'semester_id'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Student Portal Action -->
        <record id="action_lms_student_portal" model="ir.actions.act_window">
            <field name="name">Student Portals</field>
            <field name="res_model">lms.student.portal</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_student_portal_search"/>
        </record>

        <!-- Student Portals Menu Item -->
        <menuitem id="menu_lms_student_portals" name="Student Portals"
                  parent="lms_module.menu_root"
                  action="action_lms_student_portal" 
                  sequence="9"/>

        <!-- Student Schedule Tree View -->
        <record id="view_lms_student_schedule_tree" model="ir.ui.view">
            <field name="name">lms.student.schedule.tree</field>
            <field name="model">lms.schedule</field>
            <field name="arch" type="xml">
                <tree decoration-danger="is_full" decoration-info="state == 'draft'" decoration-success="state == 'active'">
                    <field name="name"/>
                    <field name="course_id"/>
                    <field name="teacher_assignment_id"/>
                    <field name="day_of_week"/>
                    <field name="start_time" widget="float_time"/>
                    <field name="end_time" widget="float_time"/>
                    <field name="classroom"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Student Schedule Search View -->
        <record id="view_lms_student_schedule_search" model="ir.ui.view">
            <field name="name">lms.student.schedule.search</field>
            <field name="model">lms.schedule</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="course_id"/>
                    <field name="teacher_assignment_id"/>
                    <field name="classroom"/>
                    <separator/>
                    <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                    <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}"/>
                        <filter string="Day of Week" name="group_by_day" context="{'group_by': 'day_of_week'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Student Schedule Action -->
        <record id="action_lms_student_schedule" model="ir.actions.act_window">
            <field name="name">My Schedule</field>
            <field name="res_model">lms.schedule</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('id', 'in', [e.schedule_id.id for e in env['lms.enrollment'].search([('student_id', '=', user.id)])])]</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>

        <!-- Add Schedule to Student Portal Menu -->
        <menuitem id="menu_lms_student_schedule"
                  name="My Schedule"
                  parent="menu_lms_student_portals"
                  action="action_lms_student_schedule"
                  sequence="2"/>
    </data>
</odoo> 