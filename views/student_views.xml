<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Student Profile Form View -->
    <record id="view_lms_student_form" model="ir.ui.view">
      <field name="name">lms.student.form</field>
      <field name="model">res.users</field>
      <field name="arch" type="xml">
        <form string="Student Profile" class="lms_module o_form_view">
          <header>
            <!-- Admins and managers will see the full status, while students see only their own record -->
            <field name="academic_status" widget="statusbar" statusbar_visible="good_standing,probation,suspended"/>
          </header>
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="name" placeholder="Student Name" readonly="1"/>
              </h1>
            </div>
            <field name="image_1920" widget="image" class="oe_avatar"/>
            <notebook>
              <page string="Personal Information" name="personal_info">
                <group>
                  <group>
                    <field name="firstname" required="1"/>
                    <field name="lastname" required="1"/>
                    <field name="student_id" required="1" placeholder="Student ID"/>
                    <field name="email" widget="email"/>
                  </group>
                  <group>
                    <field name="date_of_birth" widget="date"/>
                    <field name="gender"/>
                    <field name="phone" widget="phone"/>
                    <field name="emergency_contact" placeholder="Emergency Contact"/>
                  </group>
                </group>
                <group>
                  <field name="address" placeholder="Full Address"/>
                </group>
              </page>
              <page string="Academic Information" name="academic_info">
                <group>
                  <group>
                    <field name="major"/>
                    <field name="minor"/>
                    <field name="gpa"/>
                    <field name="academic_status"/>
                  </group>
                  <group>
                    <field name="enrolled_courses" widget="many2many_tags"/>
                    <field name="dashboard_data"/>
                  </group>
                </group>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers"/>
            <field name="message_ids" widget="mail_thread"/>
          </div>
        </form>
      </field>
    </record>
  </data>
</odoo>
