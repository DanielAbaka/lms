<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Student Profile Form View -->
    <record id="view_lms_student_form" model="ir.ui.view">
      <field name="name">lms.student.form</field>
      <field name="model">res.users</field>
      <field name="arch" type="xml">
        <form string="Student Profile" class="lms_module o_form_view">
          <header>
            <field name="academic_status" widget="statusbar" statusbar_visible="good_standing,probation,suspended"/>
          </header>
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="firstname"/> <field name="lastname"/>
              </h1>
            </div>
            <field name="image_1920" widget="image" class="oe_avatar"/>
            <notebook>
              <page string="Personal Information" name="personal_info">
                <group>
                  <group>
                    <field name="firstname" required="1"/>
                    <field name="lastname" required="1"/>
                    <field name="student_id" required="1" placeholder="Student ID"/>
                    <field name="email" widget="email"/>
                  </group>
                  <group>
                    <field name="date_of_birth" widget="date"/>
                    <field name="gender"/>
                    <field name="phone" widget="phone"/>
                    <field name="emergency_contact" placeholder="Emergency Contact"/>
                  </group>
                </group>
                <group>
                  <field name="address" placeholder="Full Address"/>
                </group>
              </page>
              <page string="Academic Information" name="academic_info">
                <group>
                  <group>
                    <field name="major"/>
                    <field name="minor"/>
                    <field name="gpa"/>
                    <field name="academic_status"/>
                  </group>
                  <group>
                    <field name="enrolled_courses" widget="many2many_tags"/>
                    <field name="dashboard_data"/>
                    <field name="is_student"/>
                  </group>
                </group>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers"/>
            <field name="message_ids" widget="mail_thread"/>
          </div>
        </form>
      </field>
    </record>

    <!-- Student Profile List View (Tree) -->
    <record id="view_lms_student_tree" model="ir.ui.view">
      <field name="name">lms.student.tree</field>
      <field name="model">res.users</field>
      <field name="arch" type="xml">
        <tree class="lms_module o_list_view">
          <field name="firstname"/>
          <field name="lastname"/>
          <field name="student_id"/>
          <field name="email"/>
          <field name="major"/>
          <field name="academic_status"/>
          <field name="gpa"/>
        </tree>
      </field>
    </record>

    <!-- Student Profile Search View -->
    <record id="view_lms_student_search" model="ir.ui.view">
      <field name="name">lms.student.search</field>
      <field name="model">res.users</field>
      <field name="arch" type="xml">
        <search>
          <field name="firstname"/>
          <field name="lastname"/>
          <field name="student_id"/>
          <field name="email"/>
          <field name="major"/>
          <field name="academic_status"/>
          <filter name="filter_students" string="Students" domain="[('is_student', '=', True)]"/>
          <group expand="0" string="Group By">
            <filter name="group_by_major" string="Major" context="{'group_by': 'major'}"/>
            <filter name="group_by_status" string="Academic Status" context="{'group_by': 'academic_status'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- Student Profile Action -->
    <record id="action_lms_students" model="ir.actions.act_window">
      <field name="name">Students</field>
      <field name="res_model">res.users</field>
      <field name="view_mode">kanban,tree,form</field>
      <field name="search_view_id" ref="view_lms_student_search"/>
      <field name="domain">[('is_student', '=', True)]</field>
      <field name="context">{'default_is_student': True}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Add your first student!
        </p>
        <p>
          Create student profiles to manage academic information and course enrollments.
        </p>
      </field>
    </record>

    <!-- Menu Item for Students -->
    <menuitem id="menu_lms_students" name="Students"
              parent="lms_module.menu_root"
              action="action_lms_students"
              sequence="4"/>
  </data>
</odoo>
