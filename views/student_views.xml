<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ✅ Student Profile Form View -->
    <record id="view_lms_student_form" model="ir.ui.view">
        <field name="name">lms.student.form</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="Student Profile">
                <header>
                    <button name="action_view_enrollments" type="object" 
                            string="View Enrollments" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_courses" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="course_count" widget="statinfo" string="Courses"/>
                        </button>
                        <button name="action_view_grades" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                            <field name="grade_count" widget="statinfo" string="Grades"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Student Name" required="1"/>
                        </h1>
                        <h3>
                            <field name="student_id" placeholder="Student ID" required="1"/>
                        </h3>
                    </div>
                    <notebook>
                        <page string="Academic Information" name="academic_info">
                            <group>
                                <group string="Enrollment Details">
                                    <field name="enrolled_courses" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    <field name="current_semester_id" options="{'no_create': True}"/>
                                </group>
                                <group string="Contact Information">
                                    <field name="email" widget="email"/>
                                    <field name="phone" widget="phone"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ✅ Student Profile List View (Tree) -->
    <record id="view_lms_student_tree" model="ir.ui.view">
        <field name="name">lms.student.tree</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <tree decoration-info="active==True" decoration-muted="active==False">
                <field name="image_128" widget="image" class="oe_avatar"/>
                <field name="name"/>
                <field name="student_id"/>
                <field name="email"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ✅ Student Profile Search View -->
    <record id="view_lms_student_search" model="ir.ui.view">
        <field name="name">lms.student.search</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="email"/>
                <filter name="filter_students" string="Students" domain="[('is_student', '=', True)]"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_semester" string="Semester" context="{'group_by': 'current_semester_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ✅ Student Profile Action -->
    <record id="action_lms_students" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_lms_student_search"/>
        <field name="domain">[('is_student', '=', True)]</field>
        <field name="context">{'default_is_student': True}</field>
    </record>

    <!-- ✅ Add Menu Item for Students -->
    <menuitem id="menu_lms_students" name="Students"
              parent="lms_module.menu_root"
              action="action_lms_students"
              sequence="4"
              icon="fa-users"/>
</odoo>