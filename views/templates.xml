<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <template id="listing">
          <ul>
            <li t-foreach="objects" t-as="object">
              <a t-attf-href="#{ root }/objects/#{ object.id }">
                <t t-esc="object.display_name"/>
              </a>
            </li>
          </ul>
        </template>
        <template id="object">
          <h1><t t-esc="object.display_name"/></h1>
          <dl>
            <t t-foreach="object._fields" t-as="field">
              <dt><t t-esc="field"/></dt>
              <dd><t t-esc="object[field]"/></dd>
            </t>
          </dl>
        </template>

        <!-- Portal Templates -->
        <template id="portal_my_home_lms" name="Portal My Home : LMS">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Courses</t>
                </t>
                <t t-if="not content">
                    <div class="alert alert-warning mt8" role="alert">
                        There are currently no courses available.
                    </div>
                </t>
                <t t-call="portal.portal_grid" t-if="content">
                    <t t-set="title">My Courses</t>
                    <t t-set="url" t-value="'/my/courses'"/>
                    <t t-set="create_url" t-value="'/course/register'"/>
                    <t t-set="create_title">Enroll in a Course</t>
                    <t t-set="create_text">Enroll in a Course</t>
                    <t t-set="columns">
                        <t t-set="columns" t-value="3"/>
                    </t>
                    <t t-foreach="content" t-as="course">
                        <t t-call="portal.portal_grid_cell">
                            <t t-set="title" t-value="course.name"/>
                            <t t-set="url" t-value="'/my/course/%s' % course.id"/>
                            <t t-set="description" t-value="course.description"/>
                            <t t-set="icon" t-value="'fa-graduation-cap'"/>
                        </t>
                    </t>
                </t>
            </t>
        </template>

        <template id="portal_my_course" name="Portal My Course">
            <t t-call="portal.portal_layout">
                <div class="container">
                    <div class="row mt16">
                        <div class="col-12">
                            <h2><t t-esc="course.name"/></h2>
                            <div class="alert alert-info">
                                <p><strong>Course Code:</strong> <t t-esc="course.code"/></p>
                                <p><strong>Instructor:</strong> <t t-esc="course.teacher_id.name"/></p>
                                <p><strong>Duration:</strong> <t t-esc="course.duration"/> weeks</p>
                            </div>
                        </div>
                    </div>
                    <div class="row mt16">
                        <div class="col-md-8">
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title">Course Materials</h3>
                                </div>
                                <div class="panel-body">
                                    <t t-foreach="course.document_ids" t-as="material">
                                        <div class="media">
                                            <div class="media-body">
                                                <h4 class="media-heading"><t t-esc="material.name"/></h4>
                                                <p><t t-esc="material.description"/></p>
                                                <a t-att-href="'/web/content/%s?download=true' % material.id" class="btn btn-sm btn-primary">
                                                    <i class="fa fa-download"/> Download
                                                </a>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title">Course Progress</h3>
                                </div>
                                <div class="panel-body">
                                    <div class="progress">
                                        <div class="progress-bar" role="progressbar" t-att-style="'width: %s%%' % course.progress">
                                            <t t-esc="course.progress"/>%
                                        </div>
                                    </div>
                                    <p class="mt8">Completed: <t t-esc="course.completed_modules"/>/<t t-esc="course.total_modules"/></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Email Templates -->
        <template id="email_template_course_enrollment" name="Course Enrollment Confirmation">
            <t t-call="mail.mail_template">
                <t t-set="subject">Course Enrollment Confirmation - <t t-esc="object.course_id.name"/></t>
                <t t-set="email_from">${user.email_formatted or user.company_id.email}</t>
                <t t-set="email_to">${object.student_id.email}</t>
                <t t-set="body_html">
                    <div style="margin: 0px; padding: 0px;">
                        <p>Dear <t t-esc="object.student_id.name"/>,</p>
                        <p>Your enrollment in the course "<t t-esc="object.course_id.name"/>" has been confirmed.</p>
                        <p>Course Details:</p>
                        <ul>
                            <li>Course Code: <t t-esc="object.course_id.code"/></li>
                            <li>Start Date: <t t-esc="object.start_date"/></li>
                            <li>End Date: <t t-esc="object.end_date"/></li>
                            <li>Instructor: <t t-esc="object.course_id.teacher_id.name"/></li>
                        </ul>
                        <p>You can access your course materials through the student portal.</p>
                        <p>Best regards,<br/>LMS Team</p>
                    </div>
                </t>
            </t>
        </template>

        <template id="email_template_grade_notification" name="Grade Notification">
            <t t-call="mail.mail_template">
                <t t-set="subject">Grade Notification - <t t-esc="object.course_id.name"/></t>
                <t t-set="email_from">${user.email_formatted or user.company_id.email}</t>
                <t t-set="email_to">${object.student_id.email}</t>
                <t t-set="body_html">
                    <div style="margin: 0px; padding: 0px;">
                        <p>Dear <t t-esc="object.student_id.name"/>,</p>
                        <p>Your grade for <t t-esc="object.course_id.name"/> has been updated.</p>
                        <p>Grade Details:</p>
                        <ul>
                            <li>Course: <t t-esc="object.course_id.name"/></li>
                            <li>Grade: <t t-esc="object.grade"/></t>
                            <li>Status: <t t-esc="object.status"/></t>
                        </ul>
                        <p>You can view your complete grade report in the student portal.</p>
                        <p>Best regards,<br/>LMS Team</p>
                    </div>
                </t>
            </t>
        </template>

        <!-- Website Templates -->
        <template id="website_course_catalog" name="Course Catalog">
            <t t-call="website.layout">
                <div class="container">
                    <h1 class="text-center mb32">Available Courses</h1>
                    <div class="row">
                        <t t-foreach="courses" t-as="course">
                            <div class="col-md-4 mb32">
                                <div class="card">
                                    <div class="card-body">
                                        <h3 class="card-title"><t t-esc="course.name"/></h3>
                                        <p class="card-text"><t t-esc="course.description"/></p>
                                        <ul class="list-unstyled">
                                            <li><i class="fa fa-clock-o"/> Duration: <t t-esc="course.duration"/> weeks</li>
                                            <li><i class="fa fa-user"/> Instructor: <t t-esc="course.teacher_id.name"/></li>
                                            <li><i class="fa fa-users"/> Students: <t t-esc="course.student_count"/></li>
                                        </ul>
                                        <a t-att-href="'/course/%s' % course.id" class="btn btn-primary">Learn More</a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </template>

        <template id="website_course_detail" name="Course Detail">
            <t t-call="website.layout">
                <div class="container">
                    <div class="row">
                        <div class="col-md-8">
                            <h1><t t-esc="course.name"/></h1>
                            <div class="alert alert-info">
                                <p><strong>Course Code:</strong> <t t-esc="course.code"/></p>
                                <p><strong>Instructor:</strong> <t t-esc="course.teacher_id.name"/></p>
                                <p><strong>Duration:</strong> <t t-esc="course.duration"/> weeks</p>
                                <p><strong>Students:</strong> <t t-esc="course.student_count"/></p>
                            </div>
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title">Course Description</h3>
                                </div>
                                <div class="panel-body">
                                    <t t-esc="course.description"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title">Course Schedule</h3>
                                </div>
                                <div class="panel-body">
                                    <p><strong>Start Date:</strong> <t t-esc="course.start_date"/></p>
                                    <p><strong>End Date:</strong> <t t-esc="course.end_date"/></p>
                                    <p><strong>Schedule:</strong> <t t-esc="course.schedule"/></p>
                                </div>
                            </div>
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title">Enrollment</h3>
                                </div>
                                <div class="panel-body">
                                    <t t-if="user.has_group('base.group_portal')">
                                        <a t-att-href="'/course/%s/enroll' % course.id" class="btn btn-primary btn-block">
                                            Enroll Now
                                        </a>
                                    </t>
                                    <t t-else="">
                                        <a href="/web/login?redirect=/course/<t t-esc="course.id"/>/enroll" class="btn btn-primary btn-block">
                                            Login to Enroll
                                        </a>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
