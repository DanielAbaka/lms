<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Quiz Question Form View -->
        <record id="view_lms_quiz_question_form" model="ir.ui.view">
            <field name="name">lms.quiz.question.form</field>
            <field name="model">lms.quiz.question</field>
            <field name="arch" type="xml">
                <form string="Quiz Question">
                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <field name="attempt_count" widget="statinfo" string="Attempts"/>
                            <field name="correct_count" widget="statinfo" string="Correct"/>
                        </div>
                        <notebook>
                            <page string="Question Details">
                                <group>
                                    <group>
                                        <field name="name" required="1"/>
                                        <field name="quiz_id" required="1"/>
                                        <field name="sequence"/>
                                        <field name="points" required="1"/>
                                    </group>
                                    <group>
                                        <field name="question_type" required="1"/>
                                        <field name="state"/>
                                        <field name="active"/>
                                    </group>
                                </group>
                                <group string="Explanation">
                                    <field name="explanation"/>
                                </group>
                            </page>
                            <page string="Answer Options" attrs="{'invisible': [('question_type', 'not in', ['multiple_choice', 'true_false'])]}">
                                <field name="option_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="is_correct"/>
                                        <field name="explanation"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Short Answer" attrs="{'invisible': [('question_type', '!=', 'short_answer')]}">
                                <group>
                                    <field name="correct_answer"/>
                                    <field name="keywords"/>
                                </group>
                            </page>
                            <page string="Statistics">
                                <group>
                                    <field name="attempt_count"/>
                                    <field name="correct_count"/>
                                    <field name="average_score"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Quiz Question Tree View -->
        <record id="view_lms_quiz_question_tree" model="ir.ui.view">
            <field name="name">lms.quiz.question.tree</field>
            <field name="model">lms.quiz.question</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state == 'active'">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="quiz_id"/>
                    <field name="question_type"/>
                    <field name="points"/>
                    <field name="attempt_count"/>
                    <field name="correct_count"/>
                    <field name="average_score"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Quiz Question Search View -->
        <record id="view_lms_quiz_question_search" model="ir.ui.view">
            <field name="name">lms.quiz.question.search</field>
            <field name="model">lms.quiz.question</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="quiz_id"/>
                    <field name="question_type"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                    <filter string="Archived" name="archived" domain="[('state', '=', 'archived')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Quiz" name="group_by_quiz" context="{'group_by': 'quiz_id'}"/>
                        <filter string="Question Type" name="group_by_type" context="{'group_by': 'question_type'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Quiz Question Action -->
        <record id="action_lms_quiz_question" model="ir.actions.act_window">
            <field name="name">Quiz Questions</field>
            <field name="res_model">lms.quiz.question</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lms_quiz_question_search"/>
        </record>

        <!-- Quiz Question Menu Item -->
        <menuitem id="menu_lms_quiz_question" name="Quiz Questions"
                  parent="lms_module.menu_root"
                  action="action_lms_quiz_question"
                  sequence="9"/>
    </data>
</odoo> 