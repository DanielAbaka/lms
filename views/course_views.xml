<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- ✅ Course Form View -->
        <record id="view_lms_course_form" model="ir.ui.view">
            <field name="name">lms.course.form</field>
            <field name="model">slide.channel</field>
            <field name="arch" type="xml">
                <form string="Course">
                    <header>
                        <button name="action_publish" string="Publish" type="object" 
                                class="btn-primary" attrs="{'invisible': [('website_published', '=', True)]}"/>
                        <button name="action_unpublish" string="Unpublish" type="object"
                                attrs="{'invisible': [('website_published', '=', False)]}"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,ongoing,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_students" type="object" class="oe_stat_button" icon="fa-users">
                                <field name="student_count" widget="statinfo" string="Students"/>
                            </button>
                            <button name="action_view_lessons" type="object" class="oe_stat_button" icon="fa-list">
                                <field name="total_slides" widget="statinfo" string="Lessons"/>
                            </button>
                            <button name="action_view_quizzes" type="object" class="oe_stat_button" icon="fa-question-circle">
                                <field name="quiz_count" widget="statinfo" string="Quizzes"/>
                            </button>
                            <button name="action_view_website" type="object" class="oe_stat_button" icon="fa-globe">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Portal</span>
                                </div>
                            </button>
                        </div>
                        <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="Course Title" required="1"/></h1>
                            <field name="website_published" widget="website_redirect_button" invisible="1"/>
                        </div>
                        <notebook>
                            <page string="General Information" name="general_info">
                                <div class="row mt-4">
                                    <div class="col-md-6">
                                        <div class="o_group">
                                            <group string="Course Details">
                                                <field name="academic_year_id" options="{'no_create': True}"/>
                                                <field name="semester_id" options="{'no_create': True}"/>
                                                <field name="credits"/>
                                                <field name="category_id" options="{'no_create': True}"/>
                                            </group>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="o_group">
                                            <group string="Prerequisites">
                                                <field name="prerequisite_course_ids" widget="many2many_tags"/>
                                            </group>
                                        </div>
                                    </div>
                                </div>
                                <group string="Course Description">
                                    <field name="description" widget="html" nolabel="1"/>
                                </group>
                            </page>
                            <page string="Teaching Staff" name="teachers">
                                <field name="teacher_assignment_ids" widget="one2many">
                                    <tree editable="bottom">
                                        <field name="teacher_id"/>
                                        <field name="role"/>
                                        <field name="assignment_date"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Content" name="content">
                                <field name="slide_ids" widget="one2many">
                                    <tree>
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="slide_type"/>
                                        <field name="completion_time" widget="float_time"/>
                                        <field name="total_views" string="Views"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ✅ Course Kanban View -->
        <record id="view_lms_course_kanban" model="ir.ui.view">
            <field name="name">lms.course.kanban</field>
            <field name="model">slide.channel</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" default_group_by="semester_id">
                    <field name="name"/>
                    <field name="academic_year_id"/>
                    <field name="semester_id"/>
                    <field name="credits"/>
                    <field name="image_128"/>
                    <field name="student_count"/>
                    <field name="color"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click oe_kanban_card o_kanban_record_has_image_fill oe_kanban_content o_kanban_card_content_fields o_kanban_color_#{record.color.raw_value}">
                                <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image: url(#{kanban_image('slide.channel', 'image_128', record.id.raw_value)})" role="img"/>
                                <div class="oe_kanban_details d-flex flex-column">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="d-flex align-items-baseline text-muted">
                                        <i class="fa fa-graduation-cap mr-1" role="img" aria-label="Academic Year"></i>
                                        <field name="academic_year_id"/>
                                    </div>
                                    <div class="d-flex align-items-baseline text-muted">
                                        <i class="fa fa-calendar mr-1" role="img" aria-label="Semester"></i>
                                        <field name="semester_id"/>
                                    </div>
                                    <div class="d-flex align-items-baseline text-muted mt-1">
                                        <span class="font-weight-bold">Credits: </span>
                                        <field name="credits" class="ml-1"/>
                                    </div>
                                    <div class="o_kanban_record_bottom mt-2">
                                        <div class="oe_kanban_bottom_left">
                                            <span class="badge badge-pill bg-info">
                                                <i class="fa fa-users" role="img" aria-label="Students"></i>
                                                <t t-esc="record.student_count.raw_value || 0"/> Students
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ✅ Course List View (Tree) -->
        <record id="view_lms_course_tree" model="ir.ui.view">
            <field name="name">lms.course.tree</field>
            <field name="model">slide.channel</field>
            <field name="arch" type="xml">
                <tree default_order="academic_year_id desc" decoration-success="state=='ongoing'" decoration-info="state=='draft'" decoration-muted="state=='completed'">
                    <field name="name"/>
                    <field name="academic_year_id"/>
                    <field name="semester_id"/>
                    <field name="credits"/>
                    <field name="student_count"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- ✅ Course Search View -->
        <record id="view_lms_course_search" model="ir.ui.view">
            <field name="name">lms.course.search</field>
            <field name="model">slide.channel</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="academic_year_id"/>
                    <field name="semester_id"/>
                    <field name="credits"/>
                    <filter name="current_year" string="Current Year" domain="[('academic_year_id', '=', context_today())]"/>
                    <filter name="my_courses" string="My Courses" domain="[('teacher_assignment_ids.teacher_id.user_id', '=', uid)]"/>
                    <filter name="ongoing" string="Ongoing" domain="[('state', '=', 'ongoing')]"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_academic_year" string="Academic Year" context="{'group_by': 'academic_year_id'}"/>
                        <filter name="group_by_semester" string="Semester" context="{'group_by': 'semester_id'}"/>
                        <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ✅ Course Action -->
        <record id="action_lms_courses" model="ir.actions.act_window">
            <field name="name">Courses</field>
            <field name="res_model">slide.channel</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_lms_course_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new course
                </p>
                <p>
                    Create educational courses with lessons, quizzes and teaching materials.
                </p>
            </field>
        </record>

        <!-- ✅ Add Courses to the LMS Module Menu -->
        <menuitem id="menu_lms_courses" name="Courses"
                  parent="lms_module.menu_root"
                  action="action_lms_courses"
                  sequence="3"
                  icon="fa-book"/>
    </data>
</odoo>