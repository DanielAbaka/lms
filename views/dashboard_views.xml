<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- LMS Dashboard Model - will need to be created in Python -->
    <record id="view_lms_dashboard_kanban" model="ir.ui.view">
        <field name="name">lms.dashboard.kanban</field>
        <field name="model">lms.dashboard</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard o_kanban_mobile" create="false">
                <field name="name"/>
                <field name="color"/>
                <field name="student_count"/>
                <field name="course_count"/>
                <field name="enrollment_count"/>
                <field name="pending_payment_count"/>
                <field name="active_student_count"/>
                <field name="teacher_count"/>
                <field name="upcoming_class_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="#{!selection_mode ? 'oe_kanban_card oe_kanban_global_click o_kanban_card_fancy' : ''} o_kanban_record_has_image_fill o_lms_dashboard_kanban">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <h3 class="o_kanban_record_title mt-0 mb-1">
                                        <field name="name"/>
                                    </h3>
                                </div>
                            </div>
                            <div class="container o_kanban_card_content">
                                <div class="row mt-3">
                                    <div class="col-6 col-lg-3 px-1">
                                        <a name="action_view_students" type="object">
                                            <div class="card border-0 shadow-sm o_dashboard_action mb-2">
                                                <div class="card-body p-3 text-center">
                                                    <div class="badge badge-info rounded-circle">
                                                        <i class="fa fa-users" role="img" aria-label="Students"></i>
                                                    </div>
                                                    <h2 class="mt-2 mb-0 o_value"><t t-esc="record.student_count.raw_value || 0"/></h2>
                                                    <h5 class="mt-1 mb-0 text-muted">Students</h5>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="col-6 col-lg-3 px-1">
                                        <a name="action_view_courses" type="object">
                                            <div class="card border-0 shadow-sm o_dashboard_action mb-2">
                                                <div class="card-body p-3 text-center">
                                                    <div class="badge badge-success rounded-circle">
                                                        <i class="fa fa-book" role="img" aria-label="Courses"></i>
                                                    </div>
                                                    <h2 class="mt-2 mb-0 o_value"><t t-esc="record.course_count.raw_value || 0"/></h2>
                                                    <h5 class="mt-1 mb-0 text-muted">Courses</h5>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="col-6 col-lg-3 px-1">
                                        <a name="action_view_enrollments" type="object">
                                            <div class="card border-0 shadow-sm o_dashboard_action mb-2">
                                                <div class="card-body p-3 text-center">
                                                    <div class="badge badge-warning rounded-circle">
                                                        <i class="fa fa-user-plus" role="img" aria-label="Enrollments"></i>
                                                    </div>
                                                    <h2 class="mt-2 mb-0 o_value"><t t-esc="record.enrollment_count.raw_value || 0"/></h2>
                                                    <h5 class="mt-1 mb-0 text-muted">Enrollments</h5>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="col-6 col-lg-3 px-1">
                                        <a name="action_view_teachers" type="object">
                                            <div class="card border-0 shadow-sm o_dashboard_action mb-2">
                                                <div class="card-body p-3 text-center">
                                                    <div class="badge badge-primary rounded-circle">
                                                        <i class="fa fa-chalkboard-teacher" role="img" aria-label="Teachers"></i>
                                                    </div>
                                                    <h2 class="mt-2 mb-0 o_value"><t t-esc="record.teacher_count.raw_value || 0"/></h2>
                                                    <h5 class="mt-1 mb-0 text-muted">Teachers</h5>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                                
                                <div class="row mt-3">
                                    <div class="col-12">
                                        <h4 class="mt-0 mb-2">Key Indicators</h4>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-6 col-lg-4 px-1">
                                        <a name="action_view_pending_payments" type="object">
                                            <div class="card border-0 shadow-sm bg-light o_dashboard_action mb-2">
                                                <div class="card-body p-3">
                                                    <div class="d-flex align-items-center">
                                                        <div class="mr-3">
                                                            <span class="fa fa-money-bill-wave fa-2x text-danger"></span>
                                                        </div>
                                                        <div>
                                                            <div class="h4 m-0"><t t-esc="record.pending_payment_count.raw_value || 0"/></div>
                                                            <div class="text-muted">Pending Payments</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="col-6 col-lg-4 px-1">
                                        <a name="action_view_active_students" type="object">
                                            <div class="card border-0 shadow-sm bg-light o_dashboard_action mb-2">
                                                <div class="card-body p-3">
                                                    <div class="d-flex align-items-center">
                                                        <div class="mr-3">
                                                            <span class="fa fa-user-check fa-2x text-success"></span>
                                                        </div>
                                                        <div>
                                                            <div class="h4 m-0"><t t-esc="record.active_student_count.raw_value || 0"/></div>
                                                            <div class="text-muted">Active Students</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="col-6 col-lg-4 px-1">
                                        <a name="action_view_upcoming_classes" type="object">
                                            <div class="card border-0 shadow-sm bg-light o_dashboard_action mb-2">
                                                <div class="card-body p-3">
                                                    <div class="d-flex align-items-center">
                                                        <div class="mr-3">
                                                            <span class="fa fa-calendar-alt fa-2x text-info"></span>
                                                        </div>
                                                        <div>
                                                            <div class="h4 m-0"><t t-esc="record.upcoming_class_count.raw_value || 0"/></div>
                                                            <div class="text-muted">Upcoming Classes</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                                
                                <div class="row mt-3">
                                    <div class="col-12 col-lg-6 px-1">
                                        <div class="card border-0 shadow-sm mb-2 h-100">
                                            <div class="card-header bg-white border-bottom-0">
                                                <h5 class="m-0">Recent Enrollments</h5>
                                            </div>
                                            <div class="card-body p-2">
                                                <field name="recent_enrollments" widget="many2many" readonly="1">
                                                    <tree create="false" delete="false">
                                                        <field name="student_id"/>
                                                        <field name="enrollment_date"/>
                                                        <field name="payment_status" widget="badge" decoration-success="payment_status == 'paid'" decoration-warning="payment_status == 'partial'" decoration-danger="payment_status == 'pending'"/>
                                                    </tree>
                                                </field>
                                            </div>
                                            <div class="card-footer bg-white border-top-0 text-right">
                                                <a name="action_view_enrollments" type="object" class="btn btn-link">View All</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-6 px-1">
                                        <div class="card border-0 shadow-sm mb-2 h-100">
                                            <div class="card-header bg-white border-bottom-0">
                                                <h5 class="m-0">Popular Courses</h5>
                                            </div>
                                            <div class="card-body p-2">
                                                <field name="popular_courses" widget="many2many" readonly="1">
                                                    <tree create="false" delete="false">
                                                        <field name="name"/>
                                                        <field name="student_count"/>
                                                        <field name="total_slides"/>
                                                    </tree>
                                                </field>
                                            </div>
                                            <div class="card-footer bg-white border-top-0 text-right">
                                                <a name="action_view_courses" type="object" class="btn btn-link">View All</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row mt-3 mb-3">
                                    <div class="col-12 px-1">
                                        <div class="card border-0 shadow-sm">
                                            <div class="card-header d-flex justify-content-between align-items-center bg-white border-bottom-0">
                                                <h5 class="m-0">Quick Actions</h5>
                                            </div>
                                            <div class="card-body pb-0">
                                                <div class="row">
                                                    <div class="col-6 col-md-3 text-center px-1 mb-3">
                                                        <a name="action_new_student" type="object" class="btn btn-outline-primary w-100 p-2">
                                                            <i class="fa fa-user-plus d-block mb-1" role="img" aria-label="New Student"></i>
                                                            <span>New Student</span>
                                                        </a>
                                                    </div>
                                                    <div class="col-6 col-md-3 text-center px-1 mb-3">
                                                        <a name="action_new_course" type="object" class="btn btn-outline-primary w-100 p-2">
                                                            <i class="fa fa-book-medical d-block mb-1" role="img" aria-label="New Course"></i>
                                                            <span>New Course</span>
                                                        </a>
                                                    </div>
                                                    <div class="col-6 col-md-3 text-center px-1 mb-3">
                                                        <a name="action_new_enrollment" type="object" class="btn btn-outline-primary w-100 p-2">
                                                            <i class="fa fa-user-check d-block mb-1" role="img" aria-label="New Enrollment"></i>
                                                            <span>New Enrollment</span>
                                                        </a>
                                                    </div>
                                                    <div class="col-6 col-md-3 text-center px-1 mb-3">
                                                        <a name="action_new_payment" type="object" class="btn btn-outline-primary w-100 p-2">
                                                            <i class="fa fa-money-check-alt d-block mb-1" role="img" aria-label="New Payment"></i>
                                                            <span>New Payment</span>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- ✅ Dashboard Action -->
    <record id="action_lms_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">lms.dashboard</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_lms_dashboard_kanban"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No data available for the dashboard
            </p>
            <p>
                This dashboard provides a comprehensive overview of your LMS system.
            </p>
        </field>
    </record>
</odoo> 